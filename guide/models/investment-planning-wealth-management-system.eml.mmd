%%meta name: Compliance Case Lifecycle
%%meta kind: workflow
%%workflow ComplianceCaseLifecycle entity: ComplianceCase kind: state
stateDiagram-v2
    [*] --> opened
    opened --> investigating : triage accepted
    investigating --> awaiting_information : evidence missing
    awaiting_information --> investigating : evidence received
    investigating --> escalated : senior decision required
    escalated --> reported : external report submitted
    investigating --> cleared : concern disproved
    escalated --> cleared : escalation clears concern
    reported --> closed : obligations completed
    cleared --> closed : closure approved
    closed --> [*]

%%meta name: Investor Complaint Lifecycle
%%meta kind: workflow
%%workflow InvestorComplaintLifecycle entity: InvestorComplaint kind: state
stateDiagram-v2
    [*] --> received
    received --> acknowledged : reference issued
    acknowledged --> investigating : owner starts review
    investigating --> awaiting_client : information requested
    awaiting_client --> investigating : client responds
    investigating --> resolved : remedy approved
    investigating --> rejected : grounds approved
    resolved --> escalated : client disputes outcome
    rejected --> escalated : client escalates
    resolved --> closed : response accepted
    rejected --> closed : response final
    escalated --> closed : external review completed
    closed --> [*]

%%meta name: Compliance Breach Lifecycle
%%meta kind: workflow
%%workflow ComplianceBreachLifecycle entity: ComplianceBreach kind: state
stateDiagram-v2
    [*] --> detected
    detected --> contained : exposure stopped
    contained --> investigating : scope review starts
    investigating --> remediating : cause confirmed
    remediating --> reported : notification required
    remediating --> resolved : action verified
    reported --> resolved : obligations completed
    resolved --> closed : independent closure approved
    closed --> [*]

%%meta name: Regulatory Filing Lifecycle
%%meta kind: workflow
%%workflow RegulatoryFilingLifecycle entity: RegulatoryFiling kind: state
stateDiagram-v2
    [*] --> preparing
    preparing --> pending_approval : return complete
    pending_approval --> preparing : changes requested
    pending_approval --> approved : sign-off recorded
    approved --> submitted : transmitted
    submitted --> accepted : acknowledgement received
    submitted --> rejected : authority rejects
    rejected --> correction_required : correction opened
    correction_required --> preparing : revision starts
    accepted --> [*]

%%report compliance-open-cases-due title: Compliance cases approaching or past deadline entity: ComplianceCase help: Investigations whose internal deadline is within seven days or already missed. The list is ordered by deadline because a late case can become a late statutory report. sql: SELECT case_number, case_type, priority, status, due_at, EXTRACT(day FROM due_at - now())::int AS days_left FROM bus_compliance_case WHERE deleted_at IS NULL AND status NOT IN ('cleared', 'closed') AND due_at <= now() + interval '7 days' ORDER BY due_at
%%report compliance-aml-potential-matches title: AML screenings requiring human disposition entity: AMLScreening help: Potential or confirmed matches that cannot be treated as clear until compliance documents its decision in a case. sql: SELECT screened_at, screening_type, provider, status, match_score, provider_reference FROM bus_aml_screening WHERE deleted_at IS NULL AND status IN ('potential_match', 'confirmed_match', 'error') ORDER BY screened_at
%%report compliance-beneficial-owners-unverified title: Beneficial owners not yet verified entity: BeneficialOwner help: Organizational controllers whose declarations cannot yet support completed KYC. Rejected records remain visible because the discrepancy itself requires resolution. sql: SELECT organization_id, party_id, status, ownership_percentage, effective_from, verified_on FROM bus_beneficial_owner WHERE deleted_at IS NULL AND status IN ('declared', 'verification_pending', 'rejected') ORDER BY effective_from
%%report compliance-complaints-overdue title: Complaints past their response deadline entity: InvestorComplaint help: Open grievances whose response date has passed. These are the records most likely to escalate externally and must be handled before routine service work. sql: SELECT complaint_number, category, priority, status, received_at, response_due_at, scores_reference FROM bus_investor_complaint WHERE deleted_at IS NULL AND status NOT IN ('resolved', 'rejected', 'closed') AND response_due_at < now() ORDER BY response_due_at
%%report compliance-filings-due title: Regulatory filings due within fourteen days entity: RegulatoryFiling help: Periodic and event-driven submissions needing preparation, approval or correction before the legal deadline. sql: SELECT filing_number, regulator, filing_type, reporting_period, status, due_date FROM bus_regulatory_filing WHERE deleted_at IS NULL AND status NOT IN ('accepted') AND due_date <= current_date + 14 ORDER BY due_date
%%report compliance-open-breaches title: Material breaches not yet resolved entity: ComplianceBreach chart: bar x: severity y: breaches help: Active compliance failures by severity, keeping high and critical incidents visible until remediation and notification are verified. sql: SELECT severity, COUNT(*) AS breaches FROM bus_compliance_breach WHERE deleted_at IS NULL AND status NOT IN ('resolved', 'closed') GROUP BY severity ORDER BY breaches DESC
%%report finance-fee-invoices-outstanding title: Client fees issued and not fully paid entity: FeeInvoice help: Advisory invoices with an unpaid balance, including disputes and overdue amounts, kept separate from product commission revenue. sql: SELECT invoice_number, status, invoice_date, due_date, net_amount, COALESCE(paid_amount, 0) AS paid_amount, net_amount - COALESCE(paid_amount, 0) AS outstanding FROM bus_fee_invoice WHERE deleted_at IS NULL AND status IN ('issued', 'due', 'partially_paid', 'disputed', 'overdue') ORDER BY due_date
%%report administrator-retention-reviews-due title: Retention policies due for review entity: RetentionPolicy help: Active or suspended policies whose legal basis and disposal controls need reassessment within ninety days. sql: SELECT name, record_category, status, retention_years, review_date, legal_basis FROM bus_retention_policy WHERE deleted_at IS NULL AND status IN ('active', 'suspended') AND review_date <= current_date + 90 ORDER BY review_date
%%report administrator-active-legal-holds title: Active legal holds preventing record disposal entity: LegalHold help: Preservation instructions still overriding normal retention, with their matter, scope and imposition date for custodian follow-up. sql: SELECT hold_number, status, imposed_at, reason, scope, authority_reference FROM bus_legal_hold WHERE deleted_at IS NULL AND status = 'active' ORDER BY imposed_at
%%report party-by-status title: Parties by status entity: Party chart: pie x: status y: records help: Root identity for a real-world person or organization; may participate in multiple business roles and has its own lifecycle. How parties divide across status, so the dominant group and the empty ones are both visible. sql: SELECT COALESCE(status::text, '(unset)') AS status, COUNT(*) AS records FROM bus_party WHERE deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC
%%report party-created-per-month title: Parties created per month entity: Party chart: line x: month y: records help: Root identity for a real-world person or organization; may participate in multiple business roles and has its own lifecycle. New parties per month over two years - the volume the business actually handles. sql: SELECT to_char(date_trunc('month', created_at), 'YYYY-MM') AS month, COUNT(*) AS records FROM bus_party WHERE deleted_at IS NULL AND created_at >= now() - interval '24 months' GROUP BY 1 ORDER BY 1
%%report party-age-bands title: How recently parties were changed entity: Party chart: bar x: last_changed y: records help: Root identity for a real-world person or organization; may participate in multiple business roles and has its own lifecycle. Records by time since their last change; the oldest band is the stale tail to review or retire. sql: SELECT CASE WHEN updated_at >= now() - interval '30 days' THEN 'last 30 days' WHEN updated_at >= now() - interval '90 days' THEN '30 to 90 days' WHEN updated_at >= now() - interval '180 days' THEN '90 to 180 days' ELSE 'older than 180 days' END AS last_changed, COUNT(*) AS records FROM bus_party WHERE deleted_at IS NULL GROUP BY 1 ORDER BY MIN(updated_at) DESC
%%report person-by-marital-status title: Persons by marital status entity: Person chart: bar x: marital_status y: records help: Individual specialization of Party. How persons divide across marital status, so the dominant group and the empty ones are both visible. sql: SELECT COALESCE(marital_status::text, '(unset)') AS marital_status, COUNT(*) AS records FROM bus_person WHERE deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC
%%report person-created-per-month title: Persons created per month entity: Person chart: line x: month y: records help: Individual specialization of Party. New persons per month over two years - the volume the business actually handles. sql: SELECT to_char(date_trunc('month', created_at), 'YYYY-MM') AS month, COUNT(*) AS records FROM bus_person WHERE deleted_at IS NULL AND created_at >= now() - interval '24 months' GROUP BY 1 ORDER BY 1
%%report person-per-party title: Persons per party entity: Person chart: bar x: party y: records help: Individual specialization of Party. Which party the most persons belong to; the head of the list is the concentration to know about. sql: SELECT COALESCE(p.party_type::text, '(none)') AS party, COUNT(*) AS records FROM bus_person x LEFT JOIN bus_party p ON p.id = x.party_id AND p.deleted_at IS NULL WHERE x.deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC LIMIT 10
%%report organization-created-per-month title: Organizations created per month entity: Organization chart: line x: month y: records help: Legal-entity specialization of Party, including companies, trusts, partnerships, HUFs and institutions. New organizations per month over two years - the volume the business actually handles. sql: SELECT to_char(date_trunc('month', created_at), 'YYYY-MM') AS month, COUNT(*) AS records FROM bus_organization WHERE deleted_at IS NULL AND created_at >= now() - interval '24 months' GROUP BY 1 ORDER BY 1
%%report organization-per-party title: Organizations per party entity: Organization chart: bar x: party y: records help: Legal-entity specialization of Party, including companies, trusts, partnerships, HUFs and institutions. Which party the most organizations belong to; the head of the list is the concentration to know about. sql: SELECT COALESCE(p.party_type::text, '(none)') AS party, COUNT(*) AS records FROM bus_organization x LEFT JOIN bus_party p ON p.id = x.party_id AND p.deleted_at IS NULL WHERE x.deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC LIMIT 10
%%report organization-top-organization-type title: Organizations: the most common organization type entity: Organization chart: bar x: organization_type y: records help: Legal-entity specialization of Party, including companies, trusts, partnerships, HUFs and institutions. The ten most frequent values of organization type among organizations; free text that repeats is a list the model could close. sql: SELECT COALESCE(organization_type, '(blank)') AS organization_type, COUNT(*) AS records FROM bus_organization WHERE deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC LIMIT 10
%%report household-by-status title: Households by status entity: Household chart: pie x: status y: records help: Primary consolidated wealth context for related parties and clients. How households divide across status, so the dominant group and the empty ones are both visible. sql: SELECT COALESCE(status::text, '(unset)') AS status, COUNT(*) AS records FROM bus_household WHERE deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC
%%report household-annual-income-by-status title: Total annual income by status entity: Household chart: bar x: status y: total_annual_income help: Primary consolidated wealth context for related parties and clients. Households added up on annual income, split by status, to show where the quantity sits. sql: SELECT COALESCE(status::text, '(unset)') AS status, ROUND(SUM(annual_income)::numeric, 2) AS total_annual_income FROM bus_household WHERE deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC NULLS LAST
%%report household-annual-income-per-month title: Average annual income per month entity: Household chart: line x: month y: average_annual_income help: Primary consolidated wealth context for related parties and clients. The average annual income of households created each month, to see whether the typical record is growing or shrinking. sql: SELECT to_char(date_trunc('month', created_at), 'YYYY-MM') AS month, ROUND(AVG(annual_income)::numeric, 2) AS average_annual_income FROM bus_household WHERE deleted_at IS NULL AND created_at >= now() - interval '24 months' GROUP BY 1 ORDER BY 1
%%report household-member-ownership-percentage-per-month title: Average ownership percentage per month entity: HouseholdMember chart: line x: month y: average_ownership_percentage help: Time-bounded association of a Party with a Household. The average ownership percentage of household members created each month, to see whether the typical record is growing or shrinking. sql: SELECT to_char(date_trunc('month', created_at), 'YYYY-MM') AS month, ROUND(AVG(ownership_percentage)::numeric, 2) AS average_ownership_percentage FROM bus_household_member WHERE deleted_at IS NULL AND created_at >= now() - interval '24 months' GROUP BY 1 ORDER BY 1
%%report household-member-largest-by-ownership-percentage title: The ten largest household members by ownership percentage entity: HouseholdMember chart: bar x: record y: ownership_percentage help: Time-bounded association of a Party with a Household. The records with the highest ownership percentage; worth reading for outliers and for the few that carry most of the total. sql: SELECT relationship_type::text AS record, ownership_percentage FROM bus_household_member WHERE deleted_at IS NULL AND ownership_percentage IS NOT NULL ORDER BY ownership_percentage DESC LIMIT 10
%%report household-member-per-household title: Household Members per household entity: HouseholdMember chart: bar x: household y: records help: Time-bounded association of a Party with a Household. Which household the most household members belong to; the head of the list is the concentration to know about. sql: SELECT COALESCE(p.name::text, '(none)') AS household, COUNT(*) AS records FROM bus_household_member x LEFT JOIN bus_household p ON p.id = x.household_id AND p.deleted_at IS NULL WHERE x.deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC LIMIT 10
%%report client-by-status title: Clients by status entity: Client chart: bar x: status y: records help: Onboarded advisory or distribution relationship for a Party within a Household. How clients divide across status, so the dominant group and the empty ones are both visible. sql: SELECT COALESCE(status::text, '(unset)') AS status, COUNT(*) AS records FROM bus_client WHERE deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC
%%report client-lifecycle title: Client lifecycle entity: Client chart: bar x: state y: records help: Onboarded advisory or distribution relationship for a Party within a Household. Where clients sit in their state machine, in the order the diagram draws it; a state nothing has reached shows as zero. sql: SELECT d.state, COALESCE(c.records, 0) AS records FROM (SELECT 'prospect' AS state, 0 AS position UNION ALL SELECT 'onboarding', 1 UNION ALL SELECT 'pending_kyc', 2 UNION ALL SELECT 'active', 3 UNION ALL SELECT 'suspended', 4 UNION ALL SELECT 'inactive', 5 UNION ALL SELECT 'closed', 6) d LEFT JOIN (SELECT status AS state, COUNT(*) AS records FROM bus_client WHERE deleted_at IS NULL GROUP BY 1) c ON c.state = d.state ORDER BY d.position
%%report client-created-per-month title: Clients created per month entity: Client chart: line x: month y: records help: Onboarded advisory or distribution relationship for a Party within a Household. New clients per month over two years - the volume the business actually handles. sql: SELECT to_char(date_trunc('month', created_at), 'YYYY-MM') AS month, COUNT(*) AS records FROM bus_client WHERE deleted_at IS NULL AND created_at >= now() - interval '24 months' GROUP BY 1 ORDER BY 1
%%report client-top-client-type title: Clients: the most common client type entity: Client chart: bar x: client_type y: records help: Onboarded advisory or distribution relationship for a Party within a Household. The ten most frequent values of client type among clients; free text that repeats is a list the model could close. sql: SELECT COALESCE(client_type, '(blank)') AS client_type, COUNT(*) AS records FROM bus_client WHERE deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC LIMIT 10
%%report client-top-service-model title: Clients: the most common service model entity: Client chart: bar x: service_model y: records help: Onboarded advisory or distribution relationship for a Party within a Household. The ten most frequent values of service model among clients; free text that repeats is a list the model could close. sql: SELECT COALESCE(service_model, '(blank)') AS service_model, COUNT(*) AS records FROM bus_client WHERE deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC LIMIT 10
%%report address-per-party title: Addresses per party entity: Address chart: bar x: party y: records help: A postal location used for client correspondence and identity evidence. Which party the most addresses belong to; the head of the list is the concentration to know about. sql: SELECT COALESCE(p.party_type::text, '(none)') AS party, COUNT(*) AS records FROM bus_address x LEFT JOIN bus_party p ON p.id = x.party_id AND p.deleted_at IS NULL WHERE x.deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC LIMIT 10
%%report address-top-city title: Addresses: the most common city entity: Address chart: bar x: city y: records help: A postal location used for client correspondence and identity evidence. The ten most frequent values of city among addresses; free text that repeats is a list the model could close. sql: SELECT COALESCE(city, '(blank)') AS city, COUNT(*) AS records FROM bus_address WHERE deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC LIMIT 10
%%report address-top-region title: Addresses: the most common region entity: Address chart: bar x: region y: records help: A postal location used for client correspondence and identity evidence. The ten most frequent values of region among addresses; free text that repeats is a list the model could close. sql: SELECT COALESCE(region, '(blank)') AS region, COUNT(*) AS records FROM bus_address WHERE deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC LIMIT 10
%%report contact-point-created-per-month title: Contact Points created per month entity: ContactPoint chart: line x: month y: records help: A way to reach a party, such as email or telephone. New contact points per month over two years - the volume the business actually handles. sql: SELECT to_char(date_trunc('month', created_at), 'YYYY-MM') AS month, COUNT(*) AS records FROM bus_contact_point WHERE deleted_at IS NULL AND created_at >= now() - interval '24 months' GROUP BY 1 ORDER BY 1
%%report contact-point-is-primary-share title: Contact Points: is primary entity: ContactPoint chart: pie x: is_primary y: records help: A way to reach a party, such as email or telephone. The share of contact points where is primary holds against those where it does not. sql: SELECT CASE WHEN is_primary THEN 'yes' ELSE 'no' END AS is_primary, COUNT(*) AS records FROM bus_contact_point WHERE deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC
%%report contact-point-per-party title: Contact Points per party entity: ContactPoint chart: bar x: party y: records help: A way to reach a party, such as email or telephone. Which party the most contact points belong to; the head of the list is the concentration to know about. sql: SELECT COALESCE(p.party_type::text, '(none)') AS party, COUNT(*) AS records FROM bus_contact_point x LEFT JOIN bus_party p ON p.id = x.party_id AND p.deleted_at IS NULL WHERE x.deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC LIMIT 10
%%report nominee-allocation-percentage-per-month title: Average allocation percentage per month entity: Nominee chart: line x: month y: average_allocation_percentage help: A beneficiary designated by a client, with an effective period and a share of the nominated entitlement. The average allocation percentage of nominees created each month, to see whether the typical record is growing or shrinking. sql: SELECT to_char(date_trunc('month', created_at), 'YYYY-MM') AS month, ROUND(AVG(allocation_percentage)::numeric, 2) AS average_allocation_percentage FROM bus_nominee WHERE deleted_at IS NULL AND created_at >= now() - interval '24 months' GROUP BY 1 ORDER BY 1
%%report nominee-largest-by-allocation-percentage title: The ten largest nominees by allocation percentage entity: Nominee chart: bar x: record y: allocation_percentage help: A beneficiary designated by a client, with an effective period and a share of the nominated entitlement. The records with the highest allocation percentage; worth reading for outliers and for the few that carry most of the total. sql: SELECT relationship_type::text AS record, allocation_percentage FROM bus_nominee WHERE deleted_at IS NULL AND allocation_percentage IS NOT NULL ORDER BY allocation_percentage DESC LIMIT 10
%%report nominee-per-client title: Nominees per client entity: Nominee chart: bar x: client y: records help: A beneficiary designated by a client, with an effective period and a share of the nominated entitlement. Which client the most nominees belong to; the head of the list is the concentration to know about. sql: SELECT COALESCE(p.client_number::text, '(none)') AS client, COUNT(*) AS records FROM bus_nominee x LEFT JOIN bus_client p ON p.id = x.client_id AND p.deleted_at IS NULL WHERE x.deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC LIMIT 10
%%report power-of-attorney-by-status title: Power Of Attorneys by status entity: PowerOfAttorney chart: pie x: status y: records help: Authority granted by one party to another to act within a stated scope and effective period. How power of attorneys divide across status, so the dominant group and the empty ones are both visible. sql: SELECT COALESCE(status::text, '(unset)') AS status, COUNT(*) AS records FROM bus_power_of_attorney WHERE deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC
%%report power-of-attorney-created-per-month title: Power Of Attorneys created per month entity: PowerOfAttorney chart: line x: month y: records help: Authority granted by one party to another to act within a stated scope and effective period. New power of attorneys per month over two years - the volume the business actually handles. sql: SELECT to_char(date_trunc('month', created_at), 'YYYY-MM') AS month, COUNT(*) AS records FROM bus_power_of_attorney WHERE deleted_at IS NULL AND created_at >= now() - interval '24 months' GROUP BY 1 ORDER BY 1
%%report power-of-attorney-top-scope title: Power Of Attorneys: the most common scope entity: PowerOfAttorney chart: bar x: scope y: records help: Authority granted by one party to another to act within a stated scope and effective period. The ten most frequent values of scope among power of attorneys; free text that repeats is a list the model could close. sql: SELECT COALESCE(scope, '(blank)') AS scope, COUNT(*) AS records FROM bus_power_of_attorney WHERE deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC LIMIT 10
%%report organization-unit-by-status title: Organization Units by status entity: OrganizationUnit chart: pie x: status y: records help: A branch or department within the advisory organization. How organization units divide across status, so the dominant group and the empty ones are both visible. sql: SELECT COALESCE(status::text, '(unset)') AS status, COUNT(*) AS records FROM bus_organization_unit WHERE deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC
%%report organization-unit-per-organization-unit title: Organization Units per organization unit entity: OrganizationUnit chart: bar x: organization_unit y: records help: A branch or department within the advisory organization. Which organization unit the most organization units belong to; the head of the list is the concentration to know about. sql: SELECT COALESCE(p.name::text, '(none)') AS organization_unit, COUNT(*) AS records FROM bus_organization_unit x LEFT JOIN bus_organization_unit p ON p.id = x.organization_unit_id AND p.deleted_at IS NULL WHERE x.deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC LIMIT 10
%%report organization-unit-top-unit-type title: Organization Units: the most common unit type entity: OrganizationUnit chart: bar x: unit_type y: records help: A branch or department within the advisory organization. The ten most frequent values of unit type among organization units; free text that repeats is a list the model could close. sql: SELECT COALESCE(unit_type, '(blank)') AS unit_type, COUNT(*) AS records FROM bus_organization_unit WHERE deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC LIMIT 10
