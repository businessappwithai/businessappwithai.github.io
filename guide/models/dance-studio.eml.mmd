%% ============================================================================
%% EML Example — Acme Dance Studio / Class Booking
%%
%% A booking business, modelled end to end: nine entities, both state machines
%% a booking business actually has, the cancellation cutoff that decides whether
%% a credit comes back, and the saga that promotes a waitlisted member when a
%% place is released.
%%
%% Written as the worked example for the working-session protocol in
%% llms.txt §1, so it holds that section's standard: help text on every
%% entity and every column, one %%rbac read rule per entity, and every
%% state backed by a declared %%enum. 0 errors, 0 warnings, clean under
%% --strict. Every diagram is valid, renderable Mermaid.
%%
%% It also meets the reporting minimums (llms.txt §7.2): every role can run at
%% least 50 charted reports and owns 10 dashboards. To make that honest rather
%% than padded, the member and instructor roles read the same eight tables the
%% desk does (everything but Payment), so one set of distinct questions over
%% those tables serves all four roles. Every report was run against the
%% generated schema, with and without rows, before it was kept.
%% ============================================================================

%%meta name: Acme Dance Studio
%%meta kind: erd
%%meta version: 1.0.0
%%category name: Scheduling; icon: calendar; entities: ClassOffering, ClassSession, Room
%%category name: Membership; icon: users; entities: Member, ClassPack, Booking
%%category name: Teaching; icon: user-check; entities: Instructor
%%category name: Finance; icon: credit-card; entities: Payment
%%enum MemberStatus: active, lapsed, suspended
%%enum ClassLevel: beginner, improver, intermediate, advanced
%%enum SessionStatus: scheduled, running, completed, cancelled
%%enum BookingStatus: held, attended, cancelled, forfeited, no_show
%%enum WaitlistStatus: waiting, promoted, expired
%%enum PackStatus: active, exhausted, expired
%%enum PaymentMethod: card, cash, bank_transfer
erDiagram
    Member {
        string   id PK
        string   email UK
        string   full_name
        string   phone OPTIONAL
        string   status
        date     joined_on
        boolean  marketing_opt_in
    }

    Instructor {
        string   id PK
        string   email UK
        string   full_name
        string   bio OPTIONAL
        boolean  is_active
    }

    Room {
        string   id PK
        string   code UK
        string   name
        integer  capacity
        boolean  is_active
    }

    ClassOffering {
        string   id PK
        string   code UK
        string   name
        string   level
        integer  duration_minutes
        integer  credit_cost
        boolean  is_active
    }

    ClassSession {
        string   id PK
        string   class_offering_id FK
        string   room_id FK
        string   instructor_id FK
        datetime starts_at
        datetime ends_at
        integer  capacity
        string   status
        text     cancellation_reason OPTIONAL
        datetime running_at OPTIONAL
        datetime cancelled_at OPTIONAL
        datetime completed_at OPTIONAL
    }

    Booking {
        string   id PK
        string   class_session_id FK
        string   member_id FK
        string   class_pack_id FK OPTIONAL
        string   status
        datetime booked_at
        datetime cancelled_at OPTIONAL
        boolean  fee_waived
        text     waiver_reason OPTIONAL
        datetime attended_at OPTIONAL
        datetime forfeited_at OPTIONAL
        datetime no_show_at OPTIONAL
    }

    WaitlistEntry {
        string   id PK
        string   class_session_id FK
        string   member_id FK
        integer  queue_position
        string   status
        datetime joined_at
    }

    ClassPack {
        string   id PK
        string   member_id FK
        integer  credits_purchased
        integer  credits_remaining
        date     purchased_on
        date     expires_on
        string   status
    }

    Payment {
        string   id PK
        string   class_pack_id FK
        decimal  amount
        string   method
        datetime received_at
        string   reference OPTIONAL
    }

    ClassOffering ||--o{ ClassSession  : "scheduled as"
    Room          ||--o{ ClassSession  : "hosts"
    Instructor    ||--o{ ClassSession  : "teaches"
    ClassSession  ||--o{ Booking       : "holds"
    ClassSession  ||--o{ WaitlistEntry : "queues"
    Member        ||--o{ Booking       : "makes"
    Member        ||--o{ WaitlistEntry : "joins"
    Member        ||--o{ ClassPack     : "buys"
    ClassPack     ||--o{ Booking       : "pays for"
    ClassPack     ||--o{ Payment       : "settled by"

    %%entity Member help: A person who buys class packs and books places in sessions. Created at first sign-up and kept after their last booking so attendance history survives.
    %%entity Instructor help: A teacher the studio schedules against sessions. Kept separate from Member because an instructor may also attend classes as a member.
    %%entity Room help: A physical studio space with a capacity. The capacity is the ceiling a session's bookable places are set from.
    %%entity ClassOffering help: A class the studio sells — a name, a level and a duration. Distinct from the individual sessions it is scheduled as.
    %%entity ClassSession help: One dated, timed occurrence of an offering, in a room, taught by an instructor. This is the thing a member actually books.
    %%entity Booking help: One member's place in one session. Created when the place is taken; terminal once attended, cancelled, forfeited or marked a no-show.
    %%entity WaitlistEntry help: A member's position in the queue for a full session. Promoted to a Booking in join order when a place is released.
    %%entity ClassPack help: A block of prepaid class credits bought by a member. Credits are drawn down by bookings and expire on a fixed date.
    %%entity Payment help: Money received against a class pack. Recorded once and never edited; a correction is a second, offsetting record.
    %%entity WaitlistEntry parent: ClassSession

    %%field Member.email help: The address all booking confirmations and cancellation notices go to. Unique — a second sign-up with the same address updates the existing member rather than creating a rival record.
    %%field Member.full_name help: The name shown on the instructor's attendance sheet. Stored as one field because the studio prints it, never sorts by surname.
    %%field Member.phone help: Used only for same-day cancellations, where email is too slow to be worth sending. Optional; most members never supply one.
    %%field Member.status help: active — may book; lapsed — no active pack, still visible for re-engagement; suspended — barred from booking after repeated no-shows, cleared by a manager.
    %%field Member.joined_on help: The date of first sign-up. Drives the loyalty reporting and never changes, even if the member lapses and returns.
    %%field Member.marketing_opt_in help: Consent to receive class announcements. Must be set by the member, never by staff; cleared on request and the clearing is audited.
    %%field Instructor.email help: The address the weekly teaching rota is sent to. Unique per instructor.
    %%field Instructor.full_name help: The name shown on the public timetable beside each session.
    %%field Instructor.bio help: The short paragraph shown on the timetable when a member taps the instructor's name. Optional; blank hides the panel entirely.
    %%field Instructor.is_active help: Cleared when an instructor stops teaching. Inactive instructors keep their session history but cannot be assigned to a new session.
    %%field Room.code help: The short label staff use on the printed timetable, e.g. STU1. Unique, and stable — it is written on the door.
    %%field Room.name help: The full room name shown to members, e.g. "Main Studio".
    %%field Room.capacity help: The maximum number of people the room legally holds. A session's own capacity may be lower but is never allowed above this.
    %%field Room.is_active help: Cleared while a room is out of use for refurbishment. Inactive rooms keep their past sessions but cannot take new ones.
    %%field ClassOffering.code help: The short code used on the timetable and in reporting, e.g. BALLET-1. Unique and stable across terms.
    %%field ClassOffering.name help: The class name members see when browsing the timetable.
    %%field ClassOffering.level help: beginner — no experience assumed; improver — one term completed; intermediate — assessed by an instructor; advanced — invitation only. The booking rule reads this against the member's history.
    %%field ClassOffering.duration_minutes help: How long a session of this class runs. Used to compute a session's end time when it is scheduled, so a change here does not move sessions already booked.
    %%field ClassOffering.credit_cost help: How many pack credits one place in this class costs. Advanced classes cost more than one; the booking rule refuses when the pack cannot cover it.
    %%field ClassOffering.is_active help: Cleared when a class is retired from the timetable. Past sessions survive; no new session can be scheduled against it.
    %%field ClassSession.class_offering_id help: The class being taught. Fixed at scheduling — moving a session to a different class is a cancellation and a new session, because the members who booked chose the class.
    %%field ClassSession.room_id help: Where the session runs. Changing it after bookings exist notifies every booked member, because the room is on the door they walk to.
    %%field ClassSession.instructor_id help: Who teaches it. A substitution is an edit here and is deliberately not a cancellation — the class still runs.
    %%field ClassSession.starts_at help: When the class begins, in studio local time. The cancellation cutoff is measured back from this, so it is the field the forfeit rule reads.
    %%field ClassSession.ends_at help: When the class finishes. Derived from the offering's duration at scheduling time and held rather than recomputed, so a later change to the offering cannot move a session already sold.
    %%field ClassSession.capacity help: Places available in this session. Seeded from the room's capacity and lowered for classes that need floor space; never raised above the room's.
    %%field ClassSession.status help: scheduled — open for booking; running — started, no longer bookable; completed — attendance taken; cancelled — the studio pulled it, which credits every held booking back.
    %%field ClassSession.cancellation_reason help: Why the studio cancelled. Shown to every affected member in the cancellation notice, so it is written for them, not for staff.
    %%field Booking.class_session_id help: The session the place is held in. Never changed — moving to another session is a cancellation and a new booking, so the credit accounting stays honest.
    %%field Booking.member_id help: Who holds the place. A booking may not be transferred between members; the studio's insurance names the attendee.
    %%field Booking.class_pack_id help: The pack the credit was drawn from. Blank for a drop-in place paid at the door, which is why it is optional.
    %%field Booking.status help: held — the place is reserved; attended — the member came; cancelled — released before the cutoff, credit returned; forfeited — released after the cutoff, credit kept; no_show — never cancelled and never attended, credit kept and counted toward suspension.
    %%field Booking.booked_at help: When the place was taken. Sets the member's position if the booking is later cancelled and the waitlist promotes in join order.
    %%field Booking.cancelled_at help: When the member released the place. Compared against the session's start to decide cancelled versus forfeited, so it is the field the cutoff rule reads.
    %%field Booking.fee_waived help: Set when a manager returns a credit that the cutoff rule had forfeited. Every waiver appears on the monthly exceptions report.
    %%field Booking.waiver_reason help: Why the forfeit was waived. Required whenever fee_waived is set — an unexplained waiver is the one the auditor asks about.
    %%field WaitlistEntry.class_session_id help: The full session being waited for. This is the link back to the parent record, so the entry appears as a tab on the session rather than a screen of its own.
    %%field WaitlistEntry.member_id help: Who is waiting. A member may hold only one entry per session.
    %%field WaitlistEntry.queue_position help: Place in the queue, lowest first. Assigned on joining and never renumbered, so a promotion cannot quietly reorder the people behind it.
    %%field WaitlistEntry.status help: waiting — still queued; promoted — a place was released and a Booking now exists; expired — the session started before a place came free.
    %%field WaitlistEntry.joined_at help: When the member joined the queue. The tiebreaker when two entries somehow share a position.
    %%field ClassPack.member_id help: Who owns the credits. Packs are not transferable between members, including within a household.
    %%field ClassPack.credits_purchased help: How many credits were bought. Never changes — a top-up is a second pack, which keeps each pack's expiry independent.
    %%field ClassPack.credits_remaining help: Credits still available. Decremented when a booking is held and returned when a booking is cancelled before the cutoff, but not when it is forfeited.
    %%field ClassPack.purchased_on help: The date of purchase. The expiry is measured from here, so a backdated purchase shortens the pack.
    %%field ClassPack.expires_on help: The last date a credit may be spent. Booking a session that starts after this date is refused even when credits remain.
    %%field ClassPack.status help: active — credits available and unexpired; exhausted — every credit spent; expired — the date passed with credits unspent, which the studio does not refund.
    %%field Payment.class_pack_id help: The pack this money bought. One pack may be settled by more than one payment where the studio allowed a split.
    %%field Payment.amount help: The sum received, gross, in studio currency. Never edited — a correction is a second, negative record so the trail stays intact.
    %%field Payment.method help: card — taken at the desk or online; cash — counted into the till and reconciled nightly; bank_transfer — matched against the statement, so it may be recorded days after the pack was issued.
    %%field Payment.received_at help: When the money actually arrived, not when it was keyed in. Bank transfers are commonly recorded late and the reconciliation depends on this distinction.
    %%field Payment.reference help: The card authorisation code or bank reference used to match the payment against the statement. Optional for cash, where there is nothing to match.

    %% Form layout: headed sections of two-column rows (`|` between rows,
    %% `,` within one; a row of one spans the full width).
    %%section entity: Member; name: Member; help: Who the member is and how the studio reaches them about bookings and waitlist offers.; rows: full_name, status | email, phone
    %%section entity: Member; name: Membership; help: When they joined and whether they agreed to hear about new classes.; rows: joined_on, marketing_opt_in
    %%section entity: Instructor; name: Instructor; help: Who teaches, how members reach them, and whether they can still be scheduled.; rows: full_name, is_active | email | bio
    %%section entity: Room; name: Room; help: The studio room, the code on its door, and how many dancers it safely holds.; rows: name, code | capacity, is_active
    %%section entity: ClassOffering; name: Class; help: What the class is, the level it is pitched at, and what one attendance costs in credits.; rows: name, code | level, is_active | duration_minutes, credit_cost
    %%section entity: ClassSession; name: Session; help: Which class is taught, where, by whom, and whether it is going ahead.; rows: class_offering_id | room_id, instructor_id
    %%section entity: ClassSession; name: Timing and size; help: When the session runs and how many can book it — never more than the room holds.; rows: starts_at, ends_at | capacity
    %%section entity: ClassSession; name: Cancellation; help: Why the studio called the session off; every booking on it is refunded when this is set.; rows: cancellation_reason; collapsed: true
    %%section entity: Booking; name: Booking; help: Who booked which session, the pack paying for it, and where the booking stands.; rows: member_id, class_session_id | class_pack_id | booked_at, cancelled_at
    %%section entity: Booking; name: Fee waiver; help: Whether a late-cancellation fee was waived, and the reason the front desk gave.; rows: fee_waived | waiver_reason
    %%section entity: WaitlistEntry; name: Waitlist place; help: Who is waiting for a full session, their place in the queue, and whether a seat has been offered.; rows: member_id, class_session_id | queue_position, status | joined_at
    %%section entity: ClassPack; name: Pack; help: The bundle of credits a member bought and how many are left to spend.; rows: member_id, status | credits_purchased, credits_remaining
    %%section entity: ClassPack; name: Validity; help: When the pack was bought and the day unused credits lapse.; rows: purchased_on, expires_on
    %%section entity: Payment; name: Payment; help: The money received for a pack — how much, how it was paid, and the reference the bank shows.; rows: class_pack_id, amount | method, received_at | reference

    %%field Member.status enum: MemberStatus
    %%field ClassOffering.level enum: ClassLevel
    %%field ClassSession.status enum: SessionStatus
    %%field Booking.status enum: BookingStatus
    %%field WaitlistEntry.status enum: WaitlistStatus
    %%field ClassPack.status enum: PackStatus
    %%field Payment.method enum: PaymentMethod

    %%index ClassSession(starts_at, status)
    %%index Booking(class_session_id, status)
    %%index Booking(member_id, status)
    %%index WaitlistEntry(class_session_id, queue_position)
    %%index ClassPack(member_id, status)

    %%rbac role:member|receptionist|instructor|manager on Member.read
    %%rbac role:receptionist|manager on Member.update
    %%rbac role:manager on Member.delete
    %%rbac role:member|receptionist|instructor|manager on Instructor.read
    %%rbac role:manager on Instructor.update
    %%rbac role:member|receptionist|instructor|manager on Room.read
    %%rbac role:manager on Room.update
    %%rbac role:member|receptionist|instructor|manager on ClassOffering.read
    %%rbac role:manager on ClassOffering.update
    %%rbac role:member|receptionist|instructor|manager on ClassSession.read
    %%rbac role:receptionist|manager on ClassSession.update
    %%rbac role:member|receptionist|instructor|manager on Booking.read
