stateDiagram-v2
    [*] --> held
    held --> attended  : attend
    held --> cancelled : cancel
    held --> forfeited : forfeit
    held --> no_show   : mark_no_show
    forfeited --> cancelled : waive
    attended  --> [*]
    cancelled --> [*]
    forfeited --> [*]
    no_show   --> [*]

