%%meta name: Session Lifecycle
%%meta kind: workflow
%%workflow SessionLifecycle entity: ClassSession kind: state
stateDiagram-v2
    [*] --> scheduled
    scheduled --> running   : start
    scheduled --> cancelled : cancel
    running   --> completed : complete
    completed --> [*]
    cancelled --> [*]

%% ---- Workflow — the booking lifecycle -------------------------------------
%%meta name: Booking Lifecycle
