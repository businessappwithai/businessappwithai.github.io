%%meta name: Opportunity Commercial Amount Guard
%%meta kind: rules
%%rule opportunityAmountGuard on Opportunity event: beforeUpdate priority: 10
flowchart TD
A([Opportunity change requested]) --> B{amount < 0?}
B -->|Yes| C[Reject negative commercial value]
B -->|No| D[Proceed with stage review]
C --> E([End])
D --> E
%%action rejectNegativeOpportunity validation-error when: amount < 0 message: Opportunity amount cannot be negative; use a credit adjustment instead
%%meta name: Quote Commercial Amount Guard
%%meta kind: rules
%%rule quoteAmountGuard on Quote event: beforeUpdate priority: 10
flowchart TD
A([Quote change requested]) --> B{total_amount < 0?}
B -->|Yes| C[Reject negative quoted value]
B -->|No| D[Continue approval process]
C --> E([End])
D --> E
%%action rejectNegativeQuote validation-error when: total_amount < 0 message: Quote total cannot be negative; correct the line pricing
%%meta name: Invoice Amount Guard
%%meta kind: rules
%%rule invoiceAmountGuard on Invoice event: beforeUpdate priority: 10
flowchart TD
A([Invoice change requested]) --> B{total_amount < 0?}
B -->|Yes| C[Reject negative invoice amount]
B -->|No| D[Continue billing]
C --> E([End])
D --> E
%%action rejectNegativeInvoice validation-error when: total_amount < 0 message: Invoice total cannot be negative; use a credit note
%%meta name: Recurring Revenue Snapshot Guard
%%meta kind: rules
%%rule revenueMovementGuard on RevenueMovement event: beforeCreate priority: 10
flowchart TD
A([Revenue movement recorded]) --> B{new_mrr < 0?}
B -->|Yes| C[Reject negative recurring amount]
B -->|No| D[Include in movement analysis]
C --> E([End])
D --> E
%%action rejectNegativeMrr validation-error when: new_mrr < 0 message: Recurring amount cannot be negative; record contraction through delta_mrr

%% ---- Business rule — a converted lead leaves a hand-off trail ----------------
%%meta name: Lead Conversion Trail
%%meta kind: rules
%%rule leadConversionTrail on Lead event: beforeUpdate priority: 20
flowchart TD
    A([Start: lead saved]) --> B{Status is converted?}
    B -->|No| E([End])
    B -->|Yes| C[Start the conversion trail]
    C --> E

    %%action startConversionTrail trigger-workflow when: status == "converted" workflow: LeadConversionTrail

%%meta name: Lead Conversion Trail
%%meta kind: workflow
%%workflow LeadConversionTrail entity: Lead kind: saga trigger: rule
flowchart TD
    A([Lead converted]) --> B[Record the hand-off]
    B --> C([Trail recorded])

    %%step B CreateEntity entity: LeadRoutingEvent as: conversionEventId fields: {"lead_id":"id","owner_id":"owner_id","routed_at":"converted_at","routing_type":"conversion","outcome":"converted"}

%% ---- Workflow — lifecycle hooks -------------------------------------------
%%meta name: Opportunity Hooks
%%meta kind: workflow
%%workflow OpportunityHooks entity: Opportunity kind: hook
flowchart TD
    A[Client Request] --> B[Validate Request]
    B --> C[Process Opportunity]
    C --> D[afterUpdate: recordStageHistory]
    D --> E[Response]

    %%hook afterUpdate recordStageHistory on Opportunity
