%% -- Authored CRM executive and operational reporting pack; use platform-level access control and tenant-scoped queries at runtime.
%%report exec-open-pipeline title: Executive open pipeline by stage entity: Opportunity chart: bar x: stage y: pipeline_amount help: Open opportunities by their current stage, with weighted and unweighted value separated to prevent false commitments. sql: SELECT stage, COUNT(*) AS deals, SUM(amount) AS pipeline_amount, SUM(amount * probability / 100.0) AS weighted_amount FROM bus_opportunity WHERE deleted_at IS NULL AND stage NOT IN ('closed_won','closed_lost') GROUP BY stage ORDER BY pipeline_amount DESC
%%report exec-booked-revenue title: Booked revenue by month entity: SalesOrder chart: line x: month y: booked_amount help: Accepted commercial orders by month; this is bookings rather than cash collection or recognized revenue. sql: SELECT date_trunc('month', order_date)::date AS month, COUNT(*) AS orders, SUM(total_amount) AS booked_amount FROM bus_sales_order WHERE deleted_at IS NULL AND status IN ('confirmed','fulfilling','fulfilled') GROUP BY 1 ORDER BY month DESC
%%report exec-cash-collections title: Cash collections by month entity: Payment chart: line x: month y: settled_amount help: Settled payments only; reconcile against banking and do not confuse collected cash with invoiced revenue. sql: SELECT date_trunc('month', payment_date)::date AS month, SUM(amount) AS settled_amount FROM bus_payment WHERE deleted_at IS NULL AND status = 'settled' GROUP BY 1 ORDER BY month DESC
%%report exec-ar-overdue title: Overdue receivables by customer entity: Invoice chart: bar x: account y: overdue_balance help: Finance collection priorities based on open balances after contractual due date, with void invoices excluded. sql: SELECT a.name AS account, COUNT(i.id) AS overdue_invoices, SUM(i.balance_due) AS overdue_balance FROM bus_invoice i JOIN bus_account a ON a.id=i.account_id WHERE i.deleted_at IS NULL AND i.balance_due > 0 AND i.due_date < CURRENT_DATE AND i.status NOT IN ('paid','void') GROUP BY a.id,a.name ORDER BY overdue_balance DESC
%%report exec-won-loss-trend title: Won and lost deals by actual close month entity: Opportunity chart: bar x: month y: amount help: Actual win and loss outcomes grouped by close date and currency, excluding open deals and incomplete close-date records; avoid using last edit time as a false close date. sql: SELECT date_trunc('month', actual_close_date)::date AS month, currency, stage, COUNT(*) AS deals, SUM(amount) AS amount FROM bus_opportunity WHERE deleted_at IS NULL AND actual_close_date IS NOT NULL AND stage IN ('closed_won','closed_lost') GROUP BY 1,2,3 ORDER BY month DESC
%%report exec-revenue-movement title: Recurring revenue movement by month entity: RevenueMovement chart: bar x: movement_type y: mrr_delta help: Net new, expansion, contraction, churn and reactivation movement, separated so offsets cannot hide churn. sql: SELECT date_trunc('month',effective_date)::date AS month, movement_type, SUM(delta_mrr) AS mrr_delta FROM bus_revenue_movement WHERE deleted_at IS NULL GROUP BY 1,2 ORDER BY month DESC
%%report exec-account-concentration title: Largest customer exposure entity: Account chart: bar x: account y: booked_value help: Commercial concentration by booked orders; financial risk increases when a few customers dominate revenue. sql: SELECT a.name AS account, COALESCE(SUM(o.total_amount),0) AS booked_value FROM bus_account a LEFT JOIN bus_sales_order o ON o.account_id=a.id AND o.deleted_at IS NULL AND o.status IN ('confirmed','fulfilling','fulfilled') WHERE a.deleted_at IS NULL GROUP BY a.id,a.name ORDER BY booked_value DESC LIMIT 20
%%report exec-pipeline-coverage title: Pipeline and quota by seller entity: User chart: bar x: seller y: pipeline help: Compare active pipeline to current-period quota per seller; evaluate coverage within currency and reporting period. sql: SELECT u.full_name AS seller, COALESCE(SUM(o.amount) FILTER (WHERE o.stage NOT IN ('closed_won','closed_lost')),0) AS pipeline, COALESCE((SELECT SUM(q.target_amount) FROM bus_sales_quota q WHERE q.user_id=u.id AND q.deleted_at IS NULL AND CURRENT_DATE BETWEEN q.period_start AND q.period_end),0) AS quota FROM bus_user u LEFT JOIN bus_opportunity o ON o.owner_id=u.id AND o.deleted_at IS NULL WHERE u.deleted_at IS NULL GROUP BY u.id,u.full_name ORDER BY pipeline DESC
%%report exec-customer-health title: At-risk customer accounts entity: CustomerHealthSnapshot chart: bar x: account y: health_score help: Accounts with elevated service or payment pressure, showing snapshot date to avoid treating stale scores as current. sql: SELECT a.name AS account, h.snapshot_date, h.health_score, h.risk_band, h.open_cases, h.overdue_invoices, h.recurring_revenue FROM bus_customer_health_snapshot h JOIN bus_account a ON a.id=h.account_id WHERE h.deleted_at IS NULL AND h.risk_band IN ('at_risk','critical') ORDER BY h.snapshot_date DESC,h.health_score ASC
%%report sales-stalled-opportunities title: Open opportunities untouched for 14 days entity: Opportunity help: Unworked deals are not reliable forecasts; this list is the sales coaching queue. sql: SELECT o.name AS opportunity, a.name AS account, o.stage, o.amount, o.expected_close_date, u.full_name AS owner FROM bus_opportunity o JOIN bus_account a ON a.id=o.account_id LEFT JOIN bus_user u ON u.id=o.owner_id WHERE o.deleted_at IS NULL AND o.stage NOT IN ('closed_won','closed_lost') AND o.updated_at < now() - interval '14 days' ORDER BY o.updated_at ASC
%%report sales-slipped-deals title: Open opportunities past close date entity: Opportunity help: Deals with missed close dates should be requalified and forecasted again before the next review. sql: SELECT o.name AS opportunity, a.name AS account, o.stage, o.amount, o.expected_close_date, CURRENT_DATE-o.expected_close_date AS days_late FROM bus_opportunity o JOIN bus_account a ON a.id=o.account_id WHERE o.deleted_at IS NULL AND o.stage NOT IN ('closed_won','closed_lost') AND o.expected_close_date < CURRENT_DATE ORDER BY days_late DESC
%%report sales-weighted-pipeline title: Weighted pipeline by sales owner entity: Opportunity chart: bar x: owner y: weighted_pipeline help: Probability-adjusted open deal value by owner; it is an estimate rather than a commitment. sql: SELECT u.full_name AS owner, SUM(o.amount) AS raw_pipeline, SUM(o.amount * o.probability / 100.0) AS weighted_pipeline FROM bus_opportunity o JOIN bus_user u ON u.id=o.owner_id WHERE o.deleted_at IS NULL AND o.stage NOT IN ('closed_won','closed_lost') GROUP BY u.id,u.full_name ORDER BY weighted_pipeline DESC
%%report sales-loss-reasons title: Lost-deal reasons and value entity: Opportunity chart: bar x: reason y: lost_value help: Identify product, price and competitor objections; missing reasons require stronger loss discipline. sql: SELECT COALESCE(NULLIF(loss_reason,''),'Unspecified') AS reason, COUNT(*) AS lost_deals, SUM(amount) AS lost_value FROM bus_opportunity WHERE deleted_at IS NULL AND stage='closed_lost' GROUP BY 1 ORDER BY lost_value DESC
%%report sales-deal-size title: Average opportunity value by stage entity: Opportunity chart: bar x: stage y: avg_deal_value help: Compare typical deal size across stages to detect low-value pipeline growth and forecast distortions. sql: SELECT stage, COUNT(*) AS opportunities, AVG(amount) AS avg_deal_value FROM bus_opportunity WHERE deleted_at IS NULL GROUP BY stage ORDER BY avg_deal_value DESC
%%report sales-stage-aging title: Historical opportunity stage transitions entity: OpportunityStageHistory chart: line x: month y: transitions help: Track movement through sales stages using recorded transition history rather than only current status. sql: SELECT stage, date_trunc('month',changed_at)::date AS month, COUNT(*) AS transitions FROM bus_opportunity_stage_history WHERE deleted_at IS NULL GROUP BY 1,2 ORDER BY month DESC, transitions DESC
%%report sales-pipeline-history title: Historical pipeline value by stage entity: PipelineSnapshot chart: line x: snapshot_date y: pipeline_amount help: Snapshots preserve historical pipeline movement and permit month-over-month comparisons without overwriting past assumptions. sql: SELECT snapshot_date, stage, SUM(amount) AS pipeline_amount FROM bus_pipeline_snapshot WHERE deleted_at IS NULL GROUP BY snapshot_date,stage ORDER BY snapshot_date DESC
%%report sales-probability-drift title: Probability drift by deal snapshot entity: PipelineSnapshot chart: bar x: opportunity y: highest_probability help: Flag deals with large subjective probability changes for manager review. sql: SELECT o.name AS opportunity, MIN(s.probability) AS lowest_probability, MAX(s.probability) AS highest_probability, COUNT(*) AS observations FROM bus_pipeline_snapshot s JOIN bus_opportunity o ON o.id=s.opportunity_id WHERE s.deleted_at IS NULL GROUP BY o.id,o.name HAVING COUNT(*)>1 ORDER BY MAX(s.probability)-MIN(s.probability) DESC
%%report sales-closing-30-days title: Open deals due in next 30 days entity: Opportunity help: Daily close-plan list sorted by urgency to focus the next customer conversation. sql: SELECT name AS opportunity, stage, amount, expected_close_date, probability FROM bus_opportunity WHERE deleted_at IS NULL AND stage NOT IN ('closed_won','closed_lost') AND expected_close_date BETWEEN CURRENT_DATE AND CURRENT_DATE+30 ORDER BY expected_close_date,amount DESC
%%report sales-orphaned-deals title: Open opportunities without an owner entity: Opportunity help: Unowned opportunities are accountability gaps and must be reassigned by sales operations. sql: SELECT name AS opportunity, stage, amount, expected_close_date FROM bus_opportunity WHERE deleted_at IS NULL AND owner_id IS NULL AND stage NOT IN ('closed_won','closed_lost') ORDER BY amount DESC
%%report sales-territory-performance title: Won deals by territory entity: Territory chart: bar x: territory y: won_value help: Territory-level performance against distribution and ownership; geographic boundaries may change over time. sql: SELECT t.name AS territory, COUNT(o.id) AS won_deals, COALESCE(SUM(o.amount),0) AS won_value FROM bus_territory t LEFT JOIN bus_opportunity o ON o.territory_id=t.id AND o.stage='closed_won' AND o.deleted_at IS NULL WHERE t.deleted_at IS NULL GROUP BY t.id,t.name ORDER BY won_value DESC
%%report sales-forecast-variance title: Forecast revisions over time entity: ForecastSnapshot chart: line x: snapshot_date y: committed help: Forecast review history identifies late swings in commitment and tests forecast discipline. sql: SELECT f.user_id, s.snapshot_date, SUM(s.predicted_revenue) AS predicted, SUM(s.committed_revenue) AS committed FROM bus_forecast_snapshot s JOIN bus_forecast f ON f.id=s.forecast_id WHERE s.deleted_at IS NULL GROUP BY f.user_id,s.snapshot_date ORDER BY s.snapshot_date DESC
%%report sales-forecast-adjustments title: Manual forecast adjustments by approver entity: ForecastAdjustment chart: bar x: adjusted_by y: amount_adjusted help: Manual overrides require explanation and must be distinguishable from underlying opportunity changes. sql: SELECT u.full_name AS adjusted_by, COUNT(*) AS adjustments, SUM(a.amount) AS amount_adjusted FROM bus_forecast_adjustment a LEFT JOIN bus_user u ON u.id=a.adjusted_by_id WHERE a.deleted_at IS NULL GROUP BY u.id,u.full_name ORDER BY ABS(SUM(a.amount)) DESC
%%report sales-quota-attainment title: Won opportunity value against quota entity: SalesQuota chart: bar x: seller y: won_value help: Compare closed-won values with period quotas; close date is approximated from last update and should be strengthened. sql: SELECT u.full_name AS seller, q.period_start,q.period_end, q.target_amount AS quota, COALESCE(SUM(o.amount),0) AS won_value FROM bus_sales_quota q JOIN bus_user u ON u.id=q.user_id LEFT JOIN bus_opportunity o ON o.owner_id=q.user_id AND o.stage='closed_won' AND o.deleted_at IS NULL AND o.updated_at::date BETWEEN q.period_start AND q.period_end WHERE q.deleted_at IS NULL GROUP BY q.id,u.full_name,q.period_start,q.period_end,q.target_amount ORDER BY q.period_end DESC
%%report lead-unworked-48h title: New leads unworked for 48 hours entity: Lead help: Sales speed-to-lead exception list; stale inbound interest is often lost without a call. sql: SELECT first_name,last_name,company,source,created_at,owner_id FROM bus_lead WHERE deleted_at IS NULL AND status='new' AND created_at < now()-interval '48 hours' ORDER BY created_at
%%report lead-source-performance title: Lead volume by acquisition source entity: Lead chart: bar x: source y: leads help: Lead sources can produce large volume without conversions; view both counts side by side. sql: SELECT source, COUNT(*) AS leads, COUNT(*) FILTER (WHERE status='converted') AS converted FROM bus_lead WHERE deleted_at IS NULL GROUP BY source ORDER BY leads DESC
%%report lead-funnel title: Lead qualification funnel entity: Lead chart: bar x: status y: leads help: Shows lead inventory at each disposition; conversion is a lifecycle endpoint rather than a new lead. sql: SELECT status, COUNT(*) AS leads FROM bus_lead WHERE deleted_at IS NULL GROUP BY status ORDER BY leads DESC
%%report lead-routing-speed title: Lead routing response time entity: LeadRoutingEvent chart: bar x: routing_type y: avg_response_minutes help: Compare routing strategies and follow-up delays to diagnose hot-lead leakage. sql: SELECT routing_type, COUNT(*) AS routed, AVG(response_minutes) AS avg_response_minutes FROM bus_lead_routing_event WHERE deleted_at IS NULL AND response_minutes IS NOT NULL GROUP BY routing_type ORDER BY avg_response_minutes DESC
%%report lead-routing-failures title: Failed or escalated lead assignments entity: LeadRoutingEvent chart: bar x: routing_type y: events help: Assignment rejection and escalation patterns often signal overloaded or misconfigured territories. sql: SELECT e.routing_type,e.outcome,COUNT(*) AS events FROM bus_lead_routing_event e WHERE e.deleted_at IS NULL AND outcome IN ('rejected','escalated') GROUP BY e.routing_type,e.outcome ORDER BY events DESC
%%report marketing-campaign-budget title: Campaign actual cost versus budget entity: Campaign chart: bar x: campaign y: variance help: Campaign spending overruns require review before the next allocation cycle. sql: SELECT name AS campaign,budget,actual_cost,COALESCE(actual_cost,0)-COALESCE(budget,0) AS variance FROM bus_campaign WHERE deleted_at IS NULL ORDER BY variance DESC
%%report marketing-campaign-responses title: Campaign audience response entity: CampaignMember chart: bar x: campaign y: responses help: Response count and reached audience expose poor targeting; combine with conversion before making budget decisions. sql: SELECT c.name AS campaign,COUNT(m.id) AS members,COUNT(m.id) FILTER (WHERE m.member_status IN ('responded','attended')) AS responses FROM bus_campaign c LEFT JOIN bus_campaign_member m ON m.campaign_id=c.id AND m.deleted_at IS NULL WHERE c.deleted_at IS NULL GROUP BY c.id,c.name ORDER BY responses DESC
%%report marketing-campaign-won title: Closed-won value by campaign entity: Campaign chart: bar x: campaign y: won_value help: Associated closed-won value is not causal ROI; use touchpoint attribution for a more defensible estimate. sql: SELECT c.name AS campaign,COALESCE(SUM(o.amount),0) AS won_value,MAX(c.actual_cost) AS actual_cost FROM bus_campaign c LEFT JOIN bus_opportunity o ON o.campaign_id=c.id AND o.stage='closed_won' AND o.deleted_at IS NULL WHERE c.deleted_at IS NULL GROUP BY c.id,c.name ORDER BY won_value DESC
%%report marketing-touchpoint-attribution title: Attributed influenced revenue by campaign entity: AttributionTouchpoint chart: bar x: campaign y: attributed_revenue help: Revenue attribution by recorded touchpoint role; attribution weights must be governed to avoid double counting. sql: SELECT c.name AS campaign,t.attribution_role,SUM(t.attributed_amount) AS attributed_revenue FROM bus_attribution_touchpoint t JOIN bus_campaign c ON c.id=t.campaign_id WHERE t.deleted_at IS NULL AND t.attributed_amount IS NOT NULL GROUP BY c.id,c.name,t.attribution_role ORDER BY attributed_revenue DESC
%%report marketing-unsubscribed title: Campaign opt outs and declines entity: CampaignMember chart: bar x: campaign y: members help: Opt-out trends indicate consent risk and audience fatigue; never treat a decline as permission to remarket. sql: SELECT c.name AS campaign,m.member_status,COUNT(*) AS members FROM bus_campaign_member m JOIN bus_campaign c ON c.id=m.campaign_id WHERE m.deleted_at IS NULL AND m.member_status IN ('unsubscribed','declined') GROUP BY c.id,c.name,m.member_status ORDER BY members DESC
%%report privacy-contact-preferences title: Marketing opt-out population entity: Contact help: Consent suppression counts must be honored by outbound activity and periodically reconciled to preference records. sql: SELECT COUNT(*) AS contacts,COUNT(*) FILTER (WHERE email_opt_out) AS email_opt_outs, COUNT(*) FILTER (WHERE do_not_call) AS do_not_call FROM bus_contact WHERE deleted_at IS NULL
%%report revenue-pending-quote-approvals title: Quote approvals still pending entity: QuoteApproval help: Pending discount and commercial approvals block customer commitments; escalate excessive queue age. sql: SELECT q.quote_number,a.name AS account,qa.decision,qa.created_at FROM bus_quote_approval qa JOIN bus_quote q ON q.id=qa.quote_id JOIN bus_account a ON a.id=q.account_id WHERE qa.deleted_at IS NULL AND qa.decision='pending' ORDER BY qa.created_at
%%report revenue-expired-quotes title: Expired open customer quotes entity: Quote help: An expired offer should never be accepted without reapproval of current prices and terms. sql: SELECT quote_number,account_id,total_amount,valid_until,status FROM bus_quote WHERE deleted_at IS NULL AND valid_until < CURRENT_DATE AND status NOT IN ('accepted','cancelled','expired','rejected') ORDER BY valid_until
%%report revenue-quotes-by-status title: Quote pipeline value by status entity: Quote chart: bar x: status y: quoted_value help: Distinguish submitted commercial value from approved and accepted offers. sql: SELECT status,COUNT(*) AS quotes,SUM(total_amount) AS quoted_value FROM bus_quote WHERE deleted_at IS NULL GROUP BY status ORDER BY quoted_value DESC
%%report revenue-orders-by-status title: Sales order value by lifecycle entity: SalesOrder chart: bar x: status y: order_value help: Operational backlog from accepted orders through fulfillment, excluding cancellation from booked revenue. sql: SELECT status,COUNT(*) AS orders,SUM(total_amount) AS order_value FROM bus_sales_order WHERE deleted_at IS NULL GROUP BY status ORDER BY order_value DESC
%%report revenue-contracts-expiring title: Contracts ending within 90 days entity: Contract help: Renewal owners must act before the end date; account and value are shown to prioritize outreach. sql: SELECT c.contract_number,a.name AS account,c.end_date,c.total_value,c.status FROM bus_contract c JOIN bus_account a ON a.id=c.account_id WHERE c.deleted_at IS NULL AND c.status='active' AND c.end_date BETWEEN CURRENT_DATE AND CURRENT_DATE+90 ORDER BY c.end_date
%%report revenue-renewals-due title: Upcoming renewals in the next 90 days entity: Renewal help: Customer-success renewal action queue; flag negotiated and at-risk amounts before the deadline. sql: SELECT r.due_date,r.quoted_amount,r.renewal_status,a.name AS account FROM bus_renewal r JOIN bus_subscription s ON s.id=r.subscription_id JOIN bus_account a ON a.id=s.account_id WHERE r.deleted_at IS NULL AND r.due_date BETWEEN CURRENT_DATE AND CURRENT_DATE+90 ORDER BY r.due_date
%%report revenue-subscription-mrr title: Active contracted recurring amount entity: Subscription chart: bar x: account y: recurring_amount help: Values are native recurring amounts and should be normalized by billing frequency before comparing MRR. sql: SELECT a.name AS account,SUM(s.recurring_amount) AS recurring_amount FROM bus_subscription s JOIN bus_account a ON a.id=s.account_id WHERE s.deleted_at IS NULL AND s.status='active' GROUP BY a.id,a.name ORDER BY recurring_amount DESC
%%report revenue-churn-movement title: Churn and contraction by month entity: RevenueMovement chart: line x: month y: mrr_change help: Monthly recurring revenue erosion, distinguished from temporary invoicing changes. sql: SELECT date_trunc('month',effective_date)::date AS month,movement_type,SUM(delta_mrr) AS mrr_change FROM bus_revenue_movement WHERE deleted_at IS NULL AND movement_type IN ('churn','contraction') GROUP BY 1,2 ORDER BY month DESC
%%report revenue-ar-aging title: Accounts receivable aging buckets entity: Invoice chart: bar x: aging_bucket y: outstanding help: Age unpaid balances by past-due days; collection policy and dispute handling should be applied separately. sql: SELECT CASE WHEN CURRENT_DATE-due_date BETWEEN 1 AND 30 THEN '1-30' WHEN CURRENT_DATE-due_date BETWEEN 31 AND 60 THEN '31-60' WHEN CURRENT_DATE-due_date BETWEEN 61 AND 90 THEN '61-90' ELSE '91+' END AS aging_bucket,SUM(balance_due) AS outstanding FROM bus_invoice WHERE deleted_at IS NULL AND balance_due > 0 AND due_date<CURRENT_DATE AND status NOT IN ('paid','void') GROUP BY 1 ORDER BY aging_bucket
%%report revenue-invoice-accuracy title: Invoiced amount by month entity: Invoice chart: line x: month y: invoiced help: Billing volume excluding voids; invoiced is not a synonym for cash collected or earned revenue. sql: SELECT date_trunc('month',issue_date)::date AS month,COUNT(*) AS invoices,SUM(total_amount) AS invoiced FROM bus_invoice WHERE deleted_at IS NULL AND status <> 'void' GROUP BY 1 ORDER BY month DESC
%%report revenue-payment-failures title: Failed settlement attempts entity: Payment help: Failed payment register for collection follow-up; do not count failures as money received. sql: SELECT payment_date,method,reference,amount,status FROM bus_payment WHERE deleted_at IS NULL AND status='failed' ORDER BY payment_date DESC
%%report revenue-credit-notes title: Credits issued against customers entity: CreditNote chart: bar x: status y: credit_value help: Credits and their lifecycle should reconcile to the invoice they offset. sql: SELECT date_trunc('month',issued_on)::date AS month,status,COUNT(*) AS credits,SUM(amount) AS credit_value FROM bus_credit_note WHERE deleted_at IS NULL GROUP BY 1,2 ORDER BY month DESC
%%report service-open-case-backlog title: Open support cases by priority entity: Case chart: bar x: priority y: cases help: Use priority mix to balance service capacity rather than raw ticket count alone. sql: SELECT priority,COUNT(*) AS cases FROM bus_case WHERE deleted_at IS NULL AND status NOT IN ('resolved','closed') GROUP BY priority ORDER BY cases DESC
%%report service-oldest-cases title: Oldest unresolved support cases entity: Case help: Aging customer issues risk breaches and dissatisfaction; prioritize with entitlement and severity. sql: SELECT case_number,subject,priority,status,reported_at,EXTRACT(day FROM now()-reported_at)::int AS age_days FROM bus_case WHERE deleted_at IS NULL AND status NOT IN ('resolved','closed') ORDER BY reported_at LIMIT 100
%%report service-sla-breaches title: Service breaches by breach type entity: CaseSlaBreach chart: bar x: breach_type y: breaches help: Separates response and resolution SLA misses, with actual overdue duration for remediation planning. sql: SELECT breach_type,COUNT(*) AS breaches,AVG(minutes_overdue) AS avg_minutes_overdue FROM bus_case_sla_breach WHERE deleted_at IS NULL GROUP BY breach_type ORDER BY breaches DESC
%%report service-unresolved-breaches title: Unresolved SLA breach remediation entity: CaseSlaBreach help: Breach owners should record root cause and remediation; a closed case alone does not close its SLA corrective action. sql: SELECT b.breached_at,c.case_number,b.breach_type,b.minutes_overdue,b.status,b.remediation FROM bus_case_sla_breach b JOIN bus_case c ON c.id=b.case_id WHERE b.deleted_at IS NULL AND b.status NOT IN ('resolved','waived') ORDER BY b.minutes_overdue DESC
%%report service-milestone-overdue title: Service milestones past due entity: SlaMilestone help: Outstanding milestones with missed due dates should be escalated before the next operational service review. sql: SELECT c.case_number,m.milestone_type,m.due_at,m.completed_at,m.breached FROM bus_sla_milestone m JOIN bus_case c ON c.id=m.case_id WHERE m.deleted_at IS NULL AND m.completed_at IS NULL AND m.due_at < now() ORDER BY m.due_at
%%report service-escalation-volume title: Escalations by level and status entity: Escalation chart: bar x: escalation_level y: escalations help: Escalation workload by level reveals chronic case handoff issues and management pressure. sql: SELECT escalation_level,status,COUNT(*) AS escalations FROM bus_escalation WHERE deleted_at IS NULL GROUP BY escalation_level,status ORDER BY escalations DESC
%%report service-resolution-time title: Case mean resolution hours by priority entity: Case chart: bar x: priority y: resolution_hours help: Mean resolution time by severity should be reviewed alongside percentile and SLA distribution. sql: SELECT priority,AVG(EXTRACT(epoch FROM resolved_at-reported_at)/3600.0) AS resolution_hours,COUNT(*) AS resolved_cases FROM bus_case WHERE deleted_at IS NULL AND resolved_at IS NOT NULL AND reported_at IS NOT NULL GROUP BY priority ORDER BY resolution_hours DESC
%%report service-customer-satisfaction title: Customer satisfaction score by survey entity: SurveyResponse chart: bar x: survey y: average_score help: Directional satisfaction measure; mix of NPS CSAT and effort scores should not be combined without normalization. sql: SELECT s.name AS survey,COUNT(r.id) AS responses,AVG(r.score) AS average_score FROM bus_customer_survey s LEFT JOIN bus_survey_response r ON r.customer_survey_id=s.id AND r.deleted_at IS NULL WHERE s.deleted_at IS NULL GROUP BY s.id,s.name ORDER BY average_score
%%report service-workorders-open title: Unfinished field-service work entity: FieldServiceWorkOrder chart: bar x: status y: work_orders help: Field dispatch capacity and outstanding work across scheduling states. sql: SELECT status,COUNT(*) AS work_orders FROM bus_field_service_work_order WHERE deleted_at IS NULL AND status NOT IN ('completed','cancelled') GROUP BY status ORDER BY work_orders DESC
%%report partner-registered-deals title: Partner deal registrations by approval entity: PartnerDealRegistration chart: bar x: status y: registrations help: Partners need visible status on registered deals before exclusivity and commission negotiations. sql: SELECT status,COUNT(*) AS registrations FROM bus_partner_deal_registration WHERE deleted_at IS NULL GROUP BY status ORDER BY registrations DESC
%%report partner-commission-payable title: Partner commissions awaiting payment entity: PartnerCommission chart: bar x: partner y: total_commission help: Accrued commission is not necessarily payable; finance should confirm approvals before settlement. sql: SELECT a.name AS partner,c.status,COUNT(*) AS commissions,SUM(c.commission_amount) AS total_commission FROM bus_partner_commission c JOIN bus_partner p ON p.id=c.partner_id JOIN bus_account a ON a.id=p.account_id WHERE c.deleted_at IS NULL AND c.status IN ('accrued','approved') GROUP BY p.id,a.name,c.status ORDER BY total_commission DESC
%%report quality-finding-backlog title: Open data quality issues by severity entity: DataQualityFinding chart: bar x: severity y: open_findings help: Operational correction queue for record defects that undermine forecasts and reporting trust. sql: SELECT severity,issue_type,COUNT(*) AS open_findings FROM bus_data_quality_finding WHERE deleted_at IS NULL AND status NOT IN ('resolved','accepted_risk') GROUP BY severity,issue_type ORDER BY open_findings DESC
%%report quality-missing-account-contacts title: Accounts without any contact entity: Account help: Incomplete customer 360 records should be repaired before campaign or quote outreach. sql: SELECT a.name AS account,a.account_type,a.account_number FROM bus_account a LEFT JOIN bus_contact c ON c.account_id=a.id AND c.deleted_at IS NULL WHERE a.deleted_at IS NULL GROUP BY a.id,a.name,a.account_type,a.account_number HAVING COUNT(c.id)=0 ORDER BY a.name
%%report quality-import-failures title: Data import errors by source entity: DataImportJob chart: bar x: source_system y: error_rows help: Detect recurring ingestion defects and supplier feed problems before they pollute CRM analytics. sql: SELECT source_system,COUNT(*) AS import_jobs,SUM(error_count) AS error_rows,SUM(record_count) AS input_rows FROM bus_data_import_job WHERE deleted_at IS NULL GROUP BY source_system ORDER BY error_rows DESC
%%report quality-integration-failures title: Failed integration messages entity: IntegrationEvent chart: bar x: event_type y: messages help: Retry and dead-letter queues should be reconciled to prevent missing orders, payments and activities. sql: SELECT event_type,status,COUNT(*) AS messages FROM bus_integration_event WHERE deleted_at IS NULL AND status IN ('failed','dead_letter') GROUP BY event_type,status ORDER BY messages DESC
%%report quality-privacy-requests-overdue title: Overdue data subject requests entity: DataSubjectRequest help: Compliance operations must track deadlines by applicable jurisdiction rather than assume a global legal deadline. sql: SELECT request_type,status,received_at,due_at,contact_id FROM bus_data_subject_request WHERE deleted_at IS NULL AND status NOT IN ('fulfilled','denied') AND due_at<CURRENT_DATE ORDER BY due_at
%%report quality-open-approvals title: Pending approval requests entity: ApprovalRequest chart: bar x: status y: approvals help: Approval queue health helps identify commercial and operations bottlenecks across CRM modules. sql: SELECT status,COUNT(*) AS approvals FROM bus_approval_request WHERE deleted_at IS NULL GROUP BY status ORDER BY approvals DESC
%%report quality-audit-changes title: Changes and exports by user entity: AuditEvent chart: bar x: actor y: events help: Changes and exports grouped by actor provide a basis for privileged activity review. sql: SELECT u.full_name AS actor,a.operation,COUNT(*) AS events FROM bus_audit_event a LEFT JOIN bus_user u ON u.id=a.user_id WHERE a.deleted_at IS NULL GROUP BY u.full_name,a.operation ORDER BY events DESC
%%report quality-unowned-leads title: Unassigned leads needing attention entity: Lead help: Missing lead assignments lead to silent pipeline loss and are measurable routing failures. sql: SELECT company,first_name,last_name,source,created_at FROM bus_lead WHERE deleted_at IS NULL AND owner_id IS NULL AND status NOT IN ('converted','unqualified') ORDER BY created_at
%%report quality-duplicate-accounts title: Potential duplicate account names entity: Account chart: bar x: normalized_name y: matching_records help: Exact normalized matches are candidates only; merge requires identity validation and data stewardship. sql: SELECT lower(trim(name)) AS normalized_name,COUNT(*) AS matching_records FROM bus_account WHERE deleted_at IS NULL GROUP BY lower(trim(name)) HAVING COUNT(*)>1 ORDER BY matching_records DESC
%%report tenant-created-per-month title: Tenants created per month entity: Tenant chart: line x: month y: records help: Maintain a governed tenant record for the customer lifecycle; retain its history and verify ownership before changing business-critical values. New tenants per month over two years - the volume the business actually handles. sql: SELECT to_char(date_trunc('month', created_at), 'YYYY-MM') AS month, COUNT(*) AS records FROM bus_tenant WHERE deleted_at IS NULL AND created_at >= now() - interval '24 months' GROUP BY 1 ORDER BY 1
%%report tenant-top-region title: Tenants: the most common region entity: Tenant chart: bar x: region y: records help: Maintain a governed tenant record for the customer lifecycle; retain its history and verify ownership before changing business-critical values. The ten most frequent values of region among tenants; free text that repeats is a list the model could close. sql: SELECT COALESCE(region, '(blank)') AS region, COUNT(*) AS records FROM bus_tenant WHERE deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC LIMIT 10
%%report tenant-top-currency title: Tenants: the most common currency entity: Tenant chart: bar x: currency y: records help: Maintain a governed tenant record for the customer lifecycle; retain its history and verify ownership before changing business-critical values. The ten most frequent values of currency among tenants; free text that repeats is a list the model could close. sql: SELECT COALESCE(currency, '(blank)') AS currency, COUNT(*) AS records FROM bus_tenant WHERE deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC LIMIT 10
%%report business-unit-created-per-month title: Business Units created per month entity: BusinessUnit chart: line x: month y: records help: Maintain a governed business unit record for the customer lifecycle; retain its history and verify ownership before changing business-critical values. New business units per month over two years - the volume the business actually handles. sql: SELECT to_char(date_trunc('month', created_at), 'YYYY-MM') AS month, COUNT(*) AS records FROM bus_business_unit WHERE deleted_at IS NULL AND created_at >= now() - interval '24 months' GROUP BY 1 ORDER BY 1
%%report business-unit-active-share title: Business Units: active entity: BusinessUnit chart: pie x: active y: records help: Maintain a governed business unit record for the customer lifecycle; retain its history and verify ownership before changing business-critical values. The share of business units where active holds against those where it does not. sql: SELECT CASE WHEN active THEN 'yes' ELSE 'no' END AS active, COUNT(*) AS records FROM bus_business_unit WHERE deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC
%%report business-unit-per-tenant title: Business Units per tenant entity: BusinessUnit chart: bar x: tenant y: records help: Maintain a governed business unit record for the customer lifecycle; retain its history and verify ownership before changing business-critical values. Which tenant the most business units belong to; the head of the list is the concentration to know about. sql: SELECT COALESCE(p.name::text, '(none)') AS tenant, COUNT(*) AS records FROM bus_business_unit x LEFT JOIN bus_tenant p ON p.id = x.tenant_id AND p.deleted_at IS NULL WHERE x.deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC LIMIT 10
%%report user-by-role title: Users by role entity: User chart: bar x: role y: records help: Maintain a governed user record for the customer lifecycle; retain its history and verify ownership before changing business-critical values. How users divide across role, so the dominant group and the empty ones are both visible. sql: SELECT COALESCE(role::text, '(unset)') AS role, COUNT(*) AS records FROM bus_user WHERE deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC
%%report user-per-tenant title: Users per tenant entity: User chart: bar x: tenant y: records help: Maintain a governed user record for the customer lifecycle; retain its history and verify ownership before changing business-critical values. Which tenant the most users belong to; the head of the list is the concentration to know about. sql: SELECT COALESCE(p.name::text, '(none)') AS tenant, COUNT(*) AS records FROM bus_user x LEFT JOIN bus_tenant p ON p.id = x.tenant_id AND p.deleted_at IS NULL WHERE x.deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC LIMIT 10
%%report user-per-business-unit title: Users per business unit entity: User chart: bar x: business_unit y: records help: Maintain a governed user record for the customer lifecycle; retain its history and verify ownership before changing business-critical values. Which business unit the most users belong to; the head of the list is the concentration to know about. sql: SELECT COALESCE(p.name::text, '(none)') AS business_unit, COUNT(*) AS records FROM bus_user x LEFT JOIN bus_business_unit p ON p.id = x.business_unit_id AND p.deleted_at IS NULL WHERE x.deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC LIMIT 10
%%report team-created-per-month title: Teams created per month entity: Team chart: line x: month y: records help: Maintain a governed team record for the customer lifecycle; retain its history and verify ownership before changing business-critical values. New teams per month over two years - the volume the business actually handles. sql: SELECT to_char(date_trunc('month', created_at), 'YYYY-MM') AS month, COUNT(*) AS records FROM bus_team WHERE deleted_at IS NULL AND created_at >= now() - interval '24 months' GROUP BY 1 ORDER BY 1
%%report team-age-bands title: How recently teams were changed entity: Team chart: bar x: last_changed y: records help: Maintain a governed team record for the customer lifecycle; retain its history and verify ownership before changing business-critical values. Records by time since their last change; the oldest band is the stale tail to review or retire. sql: SELECT CASE WHEN updated_at >= now() - interval '30 days' THEN 'last 30 days' WHEN updated_at >= now() - interval '90 days' THEN '30 to 90 days' WHEN updated_at >= now() - interval '180 days' THEN '90 to 180 days' ELSE 'older than 180 days' END AS last_changed, COUNT(*) AS records FROM bus_team WHERE deleted_at IS NULL GROUP BY 1 ORDER BY MIN(updated_at) DESC
%%report team-per-business-unit title: Teams per business unit entity: Team chart: bar x: business_unit y: records help: Maintain a governed team record for the customer lifecycle; retain its history and verify ownership before changing business-critical values. Which business unit the most teams belong to; the head of the list is the concentration to know about. sql: SELECT COALESCE(p.name::text, '(none)') AS business_unit, COUNT(*) AS records FROM bus_team x LEFT JOIN bus_business_unit p ON p.id = x.business_unit_id AND p.deleted_at IS NULL WHERE x.deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC LIMIT 10
%%report team-membership-created-per-month title: Team Memberships created per month entity: TeamMembership chart: line x: month y: records help: Maintain a governed team membership record for the customer lifecycle; retain its history and verify ownership before changing business-critical values. New team memberships per month over two years - the volume the business actually handles. sql: SELECT to_char(date_trunc('month', created_at), 'YYYY-MM') AS month, COUNT(*) AS records FROM bus_team_membership WHERE deleted_at IS NULL AND created_at >= now() - interval '24 months' GROUP BY 1 ORDER BY 1
%%report team-membership-per-team title: Team Memberships per team entity: TeamMembership chart: bar x: team y: records help: Maintain a governed team membership record for the customer lifecycle; retain its history and verify ownership before changing business-critical values. Which team the most team memberships belong to; the head of the list is the concentration to know about. sql: SELECT COALESCE(p.name::text, '(none)') AS team, COUNT(*) AS records FROM bus_team_membership x LEFT JOIN bus_team p ON p.id = x.team_id AND p.deleted_at IS NULL WHERE x.deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC LIMIT 10
%%report team-membership-per-user title: Team Memberships per user entity: TeamMembership chart: bar x: user y: records help: Maintain a governed team membership record for the customer lifecycle; retain its history and verify ownership before changing business-critical values. Which user the most team memberships belong to; the head of the list is the concentration to know about. sql: SELECT COALESCE(p.email::text, '(none)') AS user, COUNT(*) AS records FROM bus_team_membership x LEFT JOIN bus_user p ON p.id = x.user_id AND p.deleted_at IS NULL WHERE x.deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC LIMIT 10
%%report territory-created-per-month title: Territories created per month entity: Territory chart: line x: month y: records help: Maintain a governed territory record for the customer lifecycle; retain its history and verify ownership before changing business-critical values. New territories per month over two years - the volume the business actually handles. sql: SELECT to_char(date_trunc('month', created_at), 'YYYY-MM') AS month, COUNT(*) AS records FROM bus_territory WHERE deleted_at IS NULL AND created_at >= now() - interval '24 months' GROUP BY 1 ORDER BY 1
%%report territory-per-business-unit title: Territories per business unit entity: Territory chart: bar x: business_unit y: records help: Maintain a governed territory record for the customer lifecycle; retain its history and verify ownership before changing business-critical values. Which business unit the most territories belong to; the head of the list is the concentration to know about. sql: SELECT COALESCE(p.name::text, '(none)') AS business_unit, COUNT(*) AS records FROM bus_territory x LEFT JOIN bus_business_unit p ON p.id = x.business_unit_id AND p.deleted_at IS NULL WHERE x.deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC LIMIT 10
%%report territory-top-region title: Territories: the most common region entity: Territory chart: bar x: region y: records help: Maintain a governed territory record for the customer lifecycle; retain its history and verify ownership before changing business-critical values. The ten most frequent values of region among territories; free text that repeats is a list the model could close. sql: SELECT COALESCE(region, '(blank)') AS region, COUNT(*) AS records FROM bus_territory WHERE deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC LIMIT 10
%%report territory-assignment-created-per-month title: Territory Assignments created per month entity: TerritoryAssignment chart: line x: month y: records help: Maintain a governed territory assignment record for the customer lifecycle; retain its history and verify ownership before changing business-critical values. New territory assignments per month over two years - the volume the business actually handles. sql: SELECT to_char(date_trunc('month', created_at), 'YYYY-MM') AS month, COUNT(*) AS records FROM bus_territory_assignment WHERE deleted_at IS NULL AND created_at >= now() - interval '24 months' GROUP BY 1 ORDER BY 1
%%report territory-assignment-per-territory title: Territory Assignments per territory entity: TerritoryAssignment chart: bar x: territory y: records help: Maintain a governed territory assignment record for the customer lifecycle; retain its history and verify ownership before changing business-critical values. Which territory the most territory assignments belong to; the head of the list is the concentration to know about. sql: SELECT COALESCE(p.name::text, '(none)') AS territory, COUNT(*) AS records FROM bus_territory_assignment x LEFT JOIN bus_territory p ON p.id = x.territory_id AND p.deleted_at IS NULL WHERE x.deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC LIMIT 10
%%report territory-assignment-per-account title: Territory Assignments per account entity: TerritoryAssignment chart: bar x: account y: records help: Maintain a governed territory assignment record for the customer lifecycle; retain its history and verify ownership before changing business-critical values. Which account the most territory assignments belong to; the head of the list is the concentration to know about. sql: SELECT COALESCE(p.name::text, '(none)') AS account, COUNT(*) AS records FROM bus_territory_assignment x LEFT JOIN bus_account p ON p.id = x.account_id AND p.deleted_at IS NULL WHERE x.deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC LIMIT 10
%%report sales-quota-target-amount-per-month title: Average target amount per month entity: SalesQuota chart: line x: month y: average_target_amount help: Maintain a governed sales quota record for the customer lifecycle; retain its history and verify ownership before changing business-critical values. The average target amount of sales quotas created each month, to see whether the typical record is growing or shrinking. sql: SELECT to_char(date_trunc('month', created_at), 'YYYY-MM') AS month, ROUND(AVG(target_amount)::numeric, 2) AS average_target_amount FROM bus_sales_quota WHERE deleted_at IS NULL AND created_at >= now() - interval '24 months' GROUP BY 1 ORDER BY 1
%%report sales-quota-largest-by-target-amount title: The ten largest sales quotas by target amount entity: SalesQuota chart: bar x: record y: target_amount help: Maintain a governed sales quota record for the customer lifecycle; retain its history and verify ownership before changing business-critical values. The records with the highest target amount; worth reading for outliers and for the few that carry most of the total. sql: SELECT currency::text AS record, target_amount FROM bus_sales_quota WHERE deleted_at IS NULL AND target_amount IS NOT NULL ORDER BY target_amount DESC LIMIT 10
%%report sales-quota-per-user title: Sales Quotas per user entity: SalesQuota chart: bar x: user y: records help: Maintain a governed sales quota record for the customer lifecycle; retain its history and verify ownership before changing business-critical values. Which user the most sales quotas belong to; the head of the list is the concentration to know about. sql: SELECT COALESCE(p.email::text, '(none)') AS user, COUNT(*) AS records FROM bus_sales_quota x LEFT JOIN bus_user p ON p.id = x.user_id AND p.deleted_at IS NULL WHERE x.deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC LIMIT 10
%%report account-by-account-type title: Accounts by account type entity: Account chart: pie x: account_type y: records help: Maintain a governed account record for the customer lifecycle; retain its history and verify ownership before changing business-critical values. How accounts divide across account type, so the dominant group and the empty ones are both visible. sql: SELECT COALESCE(account_type::text, '(unset)') AS account_type, COUNT(*) AS records FROM bus_account WHERE deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC
%%report account-by-industry title: Accounts by industry entity: Account chart: bar x: industry y: records help: Maintain a governed account record for the customer lifecycle; retain its history and verify ownership before changing business-critical values. How accounts divide across industry, so the dominant group and the empty ones are both visible. sql: SELECT COALESCE(industry::text, '(unset)') AS industry, COUNT(*) AS records FROM bus_account WHERE deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC
%%report account-annual-revenue-by-account-type title: Total annual revenue by account type entity: Account chart: bar x: account_type y: total_annual_revenue help: Maintain a governed account record for the customer lifecycle; retain its history and verify ownership before changing business-critical values. Accounts added up on annual revenue, split by account type, to show where the quantity sits. sql: SELECT COALESCE(account_type::text, '(unset)') AS account_type, ROUND(SUM(annual_revenue)::numeric, 2) AS total_annual_revenue FROM bus_account WHERE deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC NULLS LAST
%%report account-annual-revenue-per-month title: Average annual revenue per month entity: Account chart: line x: month y: average_annual_revenue help: Maintain a governed account record for the customer lifecycle; retain its history and verify ownership before changing business-critical values. The average annual revenue of accounts created each month, to see whether the typical record is growing or shrinking. sql: SELECT to_char(date_trunc('month', created_at), 'YYYY-MM') AS month, ROUND(AVG(annual_revenue)::numeric, 2) AS average_annual_revenue FROM bus_account WHERE deleted_at IS NULL AND created_at >= now() - interval '24 months' GROUP BY 1 ORDER BY 1
%%report account-largest-by-annual-revenue title: The ten largest accounts by annual revenue entity: Account chart: bar x: record y: annual_revenue help: Maintain a governed account record for the customer lifecycle; retain its history and verify ownership before changing business-critical values. The records with the highest annual revenue; worth reading for outliers and for the few that carry most of the total. sql: SELECT name::text AS record, annual_revenue FROM bus_account WHERE deleted_at IS NULL AND annual_revenue IS NOT NULL ORDER BY annual_revenue DESC LIMIT 10
%%report account-employees-by-account-type title: Total employees by account type entity: Account chart: bar x: account_type y: total_employees help: Maintain a governed account record for the customer lifecycle; retain its history and verify ownership before changing business-critical values. Accounts added up on employees, split by account type, to show where the quantity sits. sql: SELECT COALESCE(account_type::text, '(unset)') AS account_type, ROUND(SUM(employees)::numeric, 2) AS total_employees FROM bus_account WHERE deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC NULLS LAST
%%report account-team-by-access-level title: Account Teams by access level entity: AccountTeam chart: pie x: access_level y: records help: Maintain a governed account team record for the customer lifecycle; retain its history and verify ownership before changing business-critical values. How account teams divide across access level, so the dominant group and the empty ones are both visible. sql: SELECT COALESCE(access_level::text, '(unset)') AS access_level, COUNT(*) AS records FROM bus_account_team WHERE deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC
%%report account-team-per-account title: Account Teams per account entity: AccountTeam chart: bar x: account y: records help: Maintain a governed account team record for the customer lifecycle; retain its history and verify ownership before changing business-critical values. Which account the most account teams belong to; the head of the list is the concentration to know about. sql: SELECT COALESCE(p.name::text, '(none)') AS account, COUNT(*) AS records FROM bus_account_team x LEFT JOIN bus_account p ON p.id = x.account_id AND p.deleted_at IS NULL WHERE x.deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC LIMIT 10
%%report account-team-per-user title: Account Teams per user entity: AccountTeam chart: bar x: user y: records help: Maintain a governed account team record for the customer lifecycle; retain its history and verify ownership before changing business-critical values. Which user the most account teams belong to; the head of the list is the concentration to know about. sql: SELECT COALESCE(p.email::text, '(none)') AS user, COUNT(*) AS records FROM bus_account_team x LEFT JOIN bus_user p ON p.id = x.user_id AND p.deleted_at IS NULL WHERE x.deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC LIMIT 10
