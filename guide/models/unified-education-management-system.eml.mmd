%%rule OpenStudentSupportCase on StudentSuccessPlan event: afterCreate priority: 25
flowchart TD
A([Start: New learner success plan]) --> B{Plan requires coordinated support?}
B -->|Yes| C[Open a dedicated student case]
B -->|No| D[Retain plan without new case]
C --> E([End: Support referral recorded])
D --> E
%%action createSuccessCase trigger-workflow when: plan_status == "active" workflow: StudentSupportCaseReferral

%%meta name: Student Support Case Referral
%%meta kind: workflow
%%workflow StudentSupportCaseReferral entity: StudentSuccessPlan kind: saga trigger: rule
flowchart TD
A([Active learner success plan]) --> B[Create case for follow-up]
B --> C([Case opened for triage])
%%step B CreateEntity entity: StudentCase as: newCaseId fields: {"learner_profile_id":"learner_profile_id","subject":"name","description":"name","case_type":"academic","priority":"normal","status":"open"}
