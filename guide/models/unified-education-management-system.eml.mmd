%%meta name: RequirePositivePayment Update Rule
%%meta kind: rules
%%rule RequirePositivePaymentOnUpdate on StudentPayment event: beforeUpdate priority: 10
flowchart TD
A([Start: Validate StudentPayment]) --> B{Invalid amount?}
B -->|Yes| C([End: Reject invalid value])
B -->|No| D([End: Accept valid value])
%%action rejectUpdateRequirePositivePayment validation-error when: amount <= 0 message: The received payment amount must be greater than zero before booking a receipt.

