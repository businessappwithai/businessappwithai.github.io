    %%report admissions-stage-funnel title: Admissions funnel by stage entity: AdmissionApplication help: Registrar reviews conversion and backlog across every intake. sql: SELECT stage, COUNT(*) AS applications FROM bus_admission_application WHERE deleted_at IS NULL GROUP BY stage ORDER BY stage
    %%report admissions-review-backlog title: Applications requiring an admissions decision entity: AdmissionApplication help: Admissions officers find applicants needing intervention before intake deadlines. sql: SELECT application_number, stage, submitted_on FROM bus_admission_application WHERE deleted_at IS NULL AND stage IN ('submitted','screening','under_review') ORDER BY submitted_on
    %%report admissions-offers-expiring title: Offers expiring in the coming two weeks entity: AdmissionOffer help: Admissions officers contact admitted students before offers expire. sql: SELECT status, expires_on, COUNT(*) AS offers FROM bus_admission_offer WHERE deleted_at IS NULL AND expires_on BETWEEN CURRENT_DATE AND CURRENT_DATE + INTERVAL '14 days' GROUP BY status, expires_on ORDER BY expires_on
    %%report programs-by-status title: Student qualification progression entity: LearnerProgram help: Registrar reviews active, completed and withdrawn learner programs. sql: SELECT status, COUNT(*) AS learners FROM bus_learner_program WHERE deleted_at IS NULL GROUP BY status ORDER BY learners DESC
    %%report course-waitlist-pressure title: Course offerings with greatest waitlists entity: WaitlistEntry help: Schedulers check demand before opening new sections. sql: SELECT course_offering_id, COUNT(*) AS waiting_learners FROM bus_waitlist_entry WHERE deleted_at IS NULL GROUP BY course_offering_id ORDER BY waiting_learners DESC LIMIT 50
    %%report course-enrollment-outcomes title: Course enrollment completion outcomes entity: CourseEnrollment help: Academic leadership reviews the share of withdrawn and failed registrations. sql: SELECT status, COUNT(*) AS learners FROM bus_course_enrollment WHERE deleted_at IS NULL GROUP BY status ORDER BY learners DESC
    %%report attendance-overview title: Attendance outcomes by code entity: AttendanceEntry help: Academic teams monitor absent and late patterns to prioritize outreach. sql: SELECT attendance_code, COUNT(*) AS marked_sessions FROM bus_attendance_entry WHERE deleted_at IS NULL GROUP BY attendance_code ORDER BY marked_sessions DESC
    %%report faculty-teaching-load title: Faculty assignments per worker entity: TeachingAssignment help: Department heads review staffing imbalance across academic offerings. sql: SELECT employee_id, COUNT(*) AS assignments FROM bus_teaching_assignment WHERE deleted_at IS NULL GROUP BY employee_id ORDER BY assignments DESC
    %%report academic-standing title: Academic standing distribution entity: AcademicProgress help: Advisors monitor probation and suspended students separately from normal progress. sql: SELECT standing, COUNT(*) AS students FROM bus_academic_progress WHERE deleted_at IS NULL GROUP BY standing ORDER BY students DESC
    %%report grade-appeals title: Grade appeal pipeline entity: GradeAppeal help: Examinations team finds unresolved grading disputes and trends. sql: SELECT stage, COUNT(*) AS appeals FROM bus_grade_appeal WHERE deleted_at IS NULL GROUP BY stage ORDER BY appeals DESC
    %%report cases-by-priority title: Active student support by priority entity: StudentCase help: Advisors identify urgent cases without exposing sensitive narrative details. sql: SELECT priority, COUNT(*) AS active_cases FROM bus_student_case WHERE deleted_at IS NULL AND status NOT IN ('closed','resolved') GROUP BY priority ORDER BY active_cases DESC
    %%report student-alert-backlog title: Student alerts awaiting triage entity: StudentAlert help: Student success officers monitor unattended early-warning signals. sql: SELECT status, COUNT(*) AS alerts FROM bus_student_alert WHERE deleted_at IS NULL GROUP BY status ORDER BY alerts DESC
    %%report appointment-utilization title: Student service appointment outcomes entity: ServiceAppointment help: Service managers compare completed visits, cancellations and missed appointments. sql: SELECT status, COUNT(*) AS appointments FROM bus_service_appointment WHERE deleted_at IS NULL GROUP BY status ORDER BY appointments DESC
    %%report invoice-aging title: Outstanding learner invoices past due entity: StudentInvoice help: Finance staff identify overdue invoices for approved collection activity. sql: SELECT invoice_number, due_on, total, status FROM bus_student_invoice WHERE deleted_at IS NULL AND due_on < CURRENT_DATE AND status NOT IN ('paid','void') ORDER BY due_on
    %%report student-receipts title: Settled student payments by month entity: StudentPayment help: Finance staff reconcile collected tuition over time, excluding failed receipts. sql: SELECT DATE_TRUNC('month', paid_on)::date AS month, SUM(amount) AS received_total FROM bus_student_payment WHERE deleted_at IS NULL AND status = 'settled' GROUP BY 1 ORDER BY 1
    %%report refund-queue title: Pending student refunds entity: RefundRequest help: Finance approvers review outstanding repayments and their requested amounts. sql: SELECT status, COUNT(*) AS requests, SUM(amount) AS requested_total FROM bus_refund_request WHERE deleted_at IS NULL GROUP BY status ORDER BY requests DESC
    %%report scholarship-pipeline title: Student scholarship approval pipeline entity: ScholarshipApplication help: Student financial aid officers track pending decisions and the requested funding amount. sql: SELECT status, COUNT(*) AS applicants, SUM(requested_amount) AS requested_total FROM bus_scholarship_application WHERE deleted_at IS NULL GROUP BY status ORDER BY applicants DESC
    %%report partnership-opportunities title: Active employer placement opportunities entity: PlacementOpportunity help: Careers team tracks available roles against published placement windows. sql: SELECT title, vacancies, closes_on FROM bus_placement_opportunity WHERE deleted_at IS NULL AND status = 'placement_open' ORDER BY closes_on
    %%report fundraising-commitments title: Outstanding pledge commitments entity: GiftCommitment help: Advancement tracks unfulfilled gift commitments without confusing pledges and receipts. sql: SELECT status, COUNT(*) AS commitments, SUM(pledged_amount) AS pledged_total FROM bus_gift_commitment WHERE deleted_at IS NULL GROUP BY status ORDER BY pledged_total DESC
    %%report residence-occupancy title: Housing assignments by status entity: ResidenceAssignment help: Residence managers monitor assigned and checked-in learners for occupancy planning. sql: SELECT status, COUNT(*) AS residents FROM bus_residence_assignment WHERE deleted_at IS NULL GROUP BY status ORDER BY residents DESC
    %%report procurement-backlog title: Purchase orders awaiting receipt entity: PurchaseOrder help: Procurement monitors orders that remain unpaid commitments or undelivered goods. sql: SELECT status, COUNT(*) AS orders, SUM(total) AS committed_value FROM bus_purchase_order WHERE deleted_at IS NULL GROUP BY status ORDER BY committed_value DESC
    %%report maintenance-workload title: Campus maintenance repair queue entity: MaintenanceRequest help: Facilities officers prioritize open and assigned faults before closing work orders. sql: SELECT status, priority, COUNT(*) AS requests FROM bus_maintenance_request WHERE deleted_at IS NULL GROUP BY status, priority ORDER BY requests DESC
    %%report integration-health title: Integration processing and failure trends entity: IntegrationJob help: IT operations monitor sync failures and completed record volumes. sql: SELECT sync_status, COUNT(*) AS jobs, SUM(record_count) AS records_processed FROM bus_integration_job WHERE deleted_at IS NULL GROUP BY sync_status ORDER BY jobs DESC
    %%report access-requests title: Personal data access and erasure requests entity: DataAccessRequest help: Privacy officers prioritize pending requests using statutory response windows. sql: SELECT status, request_type, COUNT(*) AS requests FROM bus_data_access_request WHERE deleted_at IS NULL GROUP BY status, request_type ORDER BY requests DESC
    %%report financial-accounting-journals title: Journal posting status entity: JournalEntry help: Controllers reconcile draft, posted and reversed journal entries before closing accounting periods. sql: SELECT status, COUNT(*) AS entries FROM bus_journal_entry WHERE deleted_at IS NULL GROUP BY status ORDER BY entries DESC
