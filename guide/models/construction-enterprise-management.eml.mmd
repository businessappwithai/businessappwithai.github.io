%%meta name: Strategic Lead Decision
%%meta kind: rules
%%rule strategicLeadDecision on Lead event: afterUpdate priority: 20
flowchart TD
SL0([Lead updated]) --> SL1{estimated_value >= 1000000}
SL1 -->|Yes| SL2[Open strategic pursuit]
SL1 -->|No| SL3[Keep standard qualification]
SL2 --> SLZ([Decision complete])
SL3 --> SLZ
%%action openStrategicPursuit trigger-workflow when: estimated_value >= 1000000 workflow: StrategicPursuitSetup message: High-value lead accepted for strategic pursuit setup

%%meta name: Strategic Pursuit Setup
%%meta kind: workflow
%%workflow StrategicPursuitSetup entity: Lead kind: saga trigger: rule
flowchart TD
SP0([Strategic lead]) --> SP1[Create pursuit]
SP1 --> SPZ([Pursuit ready])
%%step SP1 CreateEntity entity: Opportunity as: opportunityId fields: {"name":"project_name","amount":"estimated_value"}

