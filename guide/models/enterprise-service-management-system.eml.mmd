%%meta name: Service Guardrails
%%meta kind: rules
%%rule requireCaseCustomer on Case event: beforeCreate priority: 10
flowchart TD
  A([Case proposed]) --> B{account_id and contact_id present?}
  B -->|Yes| C([Accept case])
  B -->|No| D([Reject incomplete intake])
%%action requireCustomer validation-error when: account_id == null message: A case requires an accountable customer account.
%%rule preventNegativeInventory on InventoryItem event: beforeUpdate priority: 10
flowchart TD
  A([Inventory changed]) --> B{reserved_quantity <= on_hand_quantity?}
  B -->|Yes| C([Accept balance])
  B -->|No| D([Reject over-reservation])
%%action stopOverReservation validation-error when: reserved_quantity > on_hand_quantity message: Reserved quantity cannot exceed physical on-hand stock.
%%rule requireChangeRollback on ChangeRequest event: beforeUpdate priority: 10
flowchart TD
  A([Change updated]) --> B{high risk has rollback plan?}
  B -->|Yes| C([Accept assessment])
  B -->|No| D([Reject unsafe change])
%%action stopUnsafeChange validation-error when: risk_level == "high" and rollback_plan == null message: High-risk change requires a tested rollback plan.
%%rule escalateCriticalCase on Case event: afterUpdate priority: 20
flowchart TD
  A([Case updated]) --> B{priority is critical?}
  B -->|Yes| C[Open escalation event]
  B -->|No| D([Continue normal service])
  C --> E([Escalation recorded])
%%action recordCriticalEscalation trigger-workflow when: priority == "critical" workflow: CriticalCaseEscalation message: Critical case escalation event queued.
%%meta name: Critical Case Escalation
%%meta kind: workflow
%%workflow CriticalCaseEscalation entity: Case kind: saga trigger: rule
flowchart TD
  A([Critical case accepted]) --> B[Create escalation event]
  B --> C([Escalation queued])
%%step B CreateEntity entity: IntegrationEvent as: escalationEventId fields: {"name":"case_number","event_type":"critical_case_escalated","correlation_key":"case_number","status":"pending","attempt_count":0}
%%meta name: Case Governance Hooks
%%meta kind: workflow
%%workflow CaseGovernance entity: Case kind: hook
flowchart TD
  A[Case request] --> B[Scope tenant access]
  B --> C[Validate entitlement]
  C --> D[Record audit outcome]
